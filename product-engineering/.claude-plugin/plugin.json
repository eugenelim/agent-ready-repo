{
  "name": "product-engineering",
  "version": "0.13.3",
  "description": "Turn a raw product idea into build-ready specs. Frame the outcome, test the riskiest assumption before building it, then decompose into the briefs a delivery loop can consume, plus UI copy and an upstream discovery loop.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/scripts/install-marker.py\" --install-route claude-plugins",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "author": {
    "name": "eugenelim",
    "email": "eugenelim@users.noreply.github.com"
  },
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/eugenelim/agent-ready-repo",
  "repository": "https://github.com/eugenelim/agent-ready-repo",
  "keywords": [
    "intent",
    "specs",
    "prototyping",
    "decomposition"
  ],
  "displayName": "Product Engineering"
}
