{
  "name": "github",
  "version": "0.3.0",
  "description": "Start repository work from a GitHub Issue or Milestone and keep it in step with GitHub. Then work through pull requests: review someone else's, address feedback on yours, or adopt a contributor's and carry it to merge. Nothing changes on GitHub until you approve the exact step.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/scripts/install-marker.py\" --install-route claude-plugins",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "author": {
    "name": "eugenelim",
    "email": "eugenelim@users.noreply.github.com"
  },
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/eugenelim/agent-ready-repo",
  "repository": "https://github.com/eugenelim/agent-ready-repo",
  "keywords": [
    "github",
    "issue",
    "milestone",
    "intake",
    "pull-request"
  ],
  "displayName": "GitHub"
}
