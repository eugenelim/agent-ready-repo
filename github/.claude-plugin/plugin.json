{
  "name": "github",
  "version": "0.1.3",
  "description": "Turn a GitHub Milestone into a product brief. Reads the milestone and its issues and hands off a structured brief ready to decompose into specs.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/scripts/install-marker.py\" --install-route claude-plugins",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "author": {
    "name": "eugenelim",
    "email": "eugenelim@users.noreply.github.com"
  },
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/eugenelim/agent-ready-repo",
  "repository": "https://github.com/eugenelim/agent-ready-repo",
  "keywords": [
    "github",
    "milestone",
    "brief",
    "intake",
    "receive-brief"
  ],
  "displayName": "GitHub"
}
