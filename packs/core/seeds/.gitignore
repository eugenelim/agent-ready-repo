# Local install-time scratch — written by `agentbundle install`,
# consumed by the adapt-to-project skill at session start. The path
# *is* the scope (repo-scope marker only here — user-scope marker
# lives inside ~/.agentbundle/, outside any repo).
.adapt-install-marker.toml

# Work-loop session state — per-spec scratch, never committed.
docs/specs/**/state.json
docs/specs/**/engine-state.json
# State lock: a SIGKILLed holder leaves the lockfile, and a reclaimer that dies
# mid-rename leaves a `.reclaim.<uuid>` companion.
docs/specs/**/*.json.lock
docs/specs/**/*.json.lock.reclaim.*

# Supervisor-mode worktrees.
.worktrees/

# `agentbundle pack evals run` artifacts are not source; never commit them.
.eval-workspace/

# Implementer reports — session-scratch.
docs/specs/**/notes/implementer-*.md

# Personal Claude Code overrides.
CLAUDE.local.md
.claude/settings.local.json
AGENTS.local.md

# OS / editor noise.
.DS_Store
*.swp
.vscode/
.idea/

# Python build artefacts.
__pycache__/
*.egg-info/
*.pyc
build/

# Build pipeline output.
dist/

# workspace-status repair artifacts — written by repair-plan/repair-apply;
# never committed (plan files, lock files, and atomic-write temps are session-scoped).
.workspace-repair-plan.json
.workspace-repair.lock
.workspace.toml.*.tmp
.plan.*.tmp

# Conductor scratch + per-workspace probe scaffolding.
.context/

# append-knowledge.py transients — a SIGKILL between mkstemp and replace
# would otherwise leave a partial knowledge file stageable by `git add -A`.
docs/knowledge/**/.append-*.jsonl.tmp
docs/knowledge/.append-*.jsonl.tmp
docs/knowledge/**/*.lock
docs/knowledge/*.lock
docs/knowledge/**/*.lock.stale-*
docs/knowledge/*.lock.stale-*
