{
  "name": "converters",
  "version": "0.9.4",
  "description": "Convert files without leaving the conversation. Documents and images to Markdown; Markdown to styled HTML and to branded Word, PowerPoint, and Excel; Outlook and MIME email to Markdown.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/scripts/install-marker.py\" --install-route claude-plugins",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "author": {
    "name": "eugenelim",
    "email": "eugenelim@users.noreply.github.com"
  },
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/eugenelim/agent-ready-repo",
  "repository": "https://github.com/eugenelim/agent-ready-repo",
  "keywords": [
    "markdown",
    "html",
    "msg",
    "pdf",
    "office"
  ],
  "displayName": "Converters"
}
