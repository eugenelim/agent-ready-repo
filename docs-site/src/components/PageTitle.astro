---
// Override of Starlight's PageTitle: the stage chip (or breadcrumb) and the
// page heading. `description` stays meta and search text only; a visible deck
// under every title repeated the title in other words.
//
// The id is Starlight's PAGE_TITLE_ID ('_top') — its skip-link and its
// on-this-page overview entry both target it, so it must stay on the <h1>.
import Breadcrumbs from './Breadcrumbs.astro';
import { currentStage, type Entry } from './rail';

const { title } = Astro.locals.starlightRoute.entry.data;
const stage = currentStage(Astro.locals.starlightRoute.sidebar as Entry[]);
---

{
  stage ? (
    <p class="rail-chip" data-stage={stage.key}>
      <span class="rail-dot" aria-hidden="true" />
      {stage.label}
    </p>
  ) : (
    <Breadcrumbs />
  )
}
<h1 id="_top">{title}</h1>

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }

</style>
