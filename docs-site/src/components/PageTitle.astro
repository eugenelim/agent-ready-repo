---
// Override of Starlight's PageTitle: renders the page heading plus, when the
// entry declares one, its `description` as a deck (standfirst) beneath.
//
// Starlight feeds `description` to <meta name="description"> but never renders
// it in the body, so the one-line summary a guide author writes is invisible to
// the reader. `tools/build-site.py` maps the guides' `summary:` field onto
// `description`, so one authored line now does three jobs: meta, search
// snippet, and this deck.
//
// The id is Starlight's PAGE_TITLE_ID ('_top') — its skip-link and its
// on-this-page overview entry both target it, so it must stay on the <h1>.
import Breadcrumbs from './Breadcrumbs.astro';

const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<Breadcrumbs />
<h1 id="_top">{title}</h1>
{description && <p class="page-deck">{description}</p>}

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .page-deck {
    margin-top: 0.5rem;
    margin-bottom: 0;
    max-width: 50ch;
    font-size: var(--sl-text-lg);
    line-height: 1.5;
    color: var(--sl-color-gray-3);
    text-wrap: pretty;
  }
</style>
