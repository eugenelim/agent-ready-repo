---
// Override of Starlight's PageTitle: the stage chip (or breadcrumb), the page
// heading, the page's `description` as a one-line outcome beneath it, and the
// packs the page uses. A page with no description shows no line.
//
// The id is Starlight's PAGE_TITLE_ID ('_top') — its skip-link and its
// on-this-page overview entry both target it, so it must stay on the <h1>.
import Breadcrumbs from './Breadcrumbs.astro';
import { currentStage, type Entry } from './rail';

const { title, description, uses } = Astro.locals.starlightRoute.entry.data;
const packsBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/packs/`;
const stage = currentStage(Astro.locals.starlightRoute.sidebar as Entry[]);
---

{
  stage ? (
    <p class="rail-chip" data-stage={stage.key}>
      <span class="rail-dot" aria-hidden="true" />
      {stage.label}
    </p>
  ) : (
    <Breadcrumbs />
  )
}
<h1 id="_top">{title}</h1>
{description && <p class="page-deck">{description}</p>}
{
  uses && uses.length > 0 && (
    <ul class="rail-uses" aria-label="Packs this page uses">
      {uses.map((pack) => (
        <li><a class="rail-pill" href={`${packsBase}${pack}/`}>{pack}</a></li>
      ))}
    </ul>
  )
}

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }

</style>
