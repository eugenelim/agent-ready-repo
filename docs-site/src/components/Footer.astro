---
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import sharedChrome from '../shared-chrome.generated.json';
import { docsChromeCurrent, docsChromeHref } from './shared-chrome';

const docsBase = import.meta.env.BASE_URL.replace(/\/docs\/?$/, '');
const pathname = Astro.url.pathname.startsWith(docsBase)
  ? Astro.url.pathname.slice(docsBase.length) || '/'
  : Astro.url.pathname;

---

<footer class="docs-site-footer">
  <div class="docs-site-footer__native-meta">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
  <div class="docs-site-footer__groups">
    {
      sharedChrome.footer.map((group) => (
        <section class="docs-site-footer__group" aria-labelledby={`docs-footer-${group.id}`}>
          <h2 id={`docs-footer-${group.id}`}>{group.label}</h2>
          <ul>
            {group.destinations.map((link) => (
              <li>
                <a href={docsChromeHref(link, docsBase)} aria-current={docsChromeCurrent(link, pathname)}>
                  {link.label}
                  {link.kind === 'external' && <><span aria-hidden="true"> ↗</span><span class="docs-site-footer__external"> external</span></>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <p class="docs-site-footer__quiet-line">© {new Date().getFullYear()} · agent-ready-repo</p>
</footer>

<style>
  .docs-site-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 3rem;
    border-top: 1px solid var(--doc-rule);
    padding-top: 1.5rem;
  }

  .docs-site-footer__native-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 3rem;
    color: var(--doc-text-muted);
    font-size: var(--sl-text-sm);
  }

  .docs-site-footer__groups {
    display: grid;
    gap: 1.5rem;
  }

  .docs-site-footer__group h2 {
    margin: 0 0 0.65rem;
    color: var(--doc-heading);
    font-size: 0.8125rem;
  }

  .docs-site-footer__group ul { margin: 0; padding: 0; list-style: none; }
  .docs-site-footer__group li + li { margin-top: 0.45rem; }
  .docs-site-footer__group a { color: var(--doc-text-muted); text-decoration: none; }
  .docs-site-footer__group a:hover { color: var(--doc-heading); text-decoration: underline; text-underline-offset: 0.2em; }
  .docs-site-footer__group a[aria-current] { color: var(--doc-heading); font-weight: 700; }
  .docs-site-footer__external { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .docs-site-footer__quiet-line { margin: 0; color: var(--doc-text-faint); font-size: var(--sl-text-sm); }
  .docs-site-footer :focus-visible { outline: 2px solid var(--doc-accent-strong); outline-offset: 3px; }

  @media (min-width: 50rem) {
    .docs-site-footer__groups { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>

<script>
  // Mermaid is bundled (exact pin in package.json) and lazy-loaded only on
  // pages that carry diagrams — no runtime CDN calls (spec AC9). Diagrams
  // re-render on theme toggle; the raw source persists in data-mermaid.
  // A run token guards against interleaved re-renders on rapid toggling:
  // a superseded run must not overwrite a newer theme's SVG.
  let renderRun = 0;
  const renderDiagrams = async () => {
    const els = document.querySelectorAll('.mermaid-diagram[data-mermaid]');
    if (els.length === 0) return;
    const run = ++renderRun;
    const dark = document.documentElement.dataset.theme === 'dark';
    let mermaid;
    try {
      ({ default: mermaid } = await import('mermaid'));
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: dark ? 'dark' : 'neutral',
        // The dark theme leaves edge-label backgrounds light; pin them to
        // the dark surface token so labels sit flush on the diagram ground.
        themeVariables: dark ? { edgeLabelBackground: '#111726' } : {},
      });
    } catch (e) {
      console.warn('Mermaid bundle failed to load — showing raw source', e);
      for (const el of els) {
        const pre = document.createElement('pre');
        pre.textContent = decodeURIComponent(el.getAttribute('data-mermaid') ?? '');
        el.replaceChildren(pre);
      }
      return;
    }
    for (const el of els) {
      const src = decodeURIComponent(el.getAttribute('data-mermaid') ?? '');
      const id = 'mermaid-' + Math.random().toString(36).slice(2);
      try {
        const { svg } = await mermaid.render(id, src);
        if (run !== renderRun) return; // superseded by a newer toggle
        el.innerHTML = svg;
      } catch (e) {
        console.warn('Mermaid render failed', e);
      }
    }
  };
  renderDiagrams();
  // Not disconnected: this is an MPA (no view transitions), so the script
  // and observer die with the page on every navigation. If a ClientRouter
  // ever lands, disconnect on astro:before-swap.
  new MutationObserver(renderDiagrams).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
