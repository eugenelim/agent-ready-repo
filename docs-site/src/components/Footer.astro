---
// Starlight Footer override — matches site/overrides/partials/footer.html
// Renders the prev/next navigation (via Starlight's default) plus the brand footer.
import type { Props } from '@astrojs/starlight/props';

const { entry, pagination } = Astro.props;
---

{
  pagination && (pagination.prev || pagination.next) && (
    <nav class="sl-prev-next" aria-label="Previous and next pages">
      {pagination.prev && (
        <a href={pagination.prev.href} rel="prev" class="sl-prev-next__link sl-prev-next__link--prev">
          <span class="sl-prev-next__direction">Previous</span>
          <span class="sl-prev-next__label">{pagination.prev.label}</span>
        </a>
      )}
      {pagination.next && (
        <a href={pagination.next.href} rel="next" class="sl-prev-next__link sl-prev-next__link--next">
          <span class="sl-prev-next__direction">Next</span>
          <span class="sl-prev-next__label">{pagination.next.label}</span>
        </a>
      )}
    </nav>
  )
}

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__brand">agent-ready-repo</p>
    <nav class="site-footer__links" aria-label="Site footer">
      <ul>
        <li><a href="https://eugenelim.github.io/agent-ready-repo/" rel="noopener">Platform</a></li>
        <li><a href="https://github.com/eugenelim/agent-ready-repo" rel="noopener">GitHub</a></li>
        <li><a href="https://pypi.org/project/agentbundle/" rel="noopener">PyPI</a></li>
      </ul>
    </nav>
    <p class="site-footer__copy">© 2026 · The supervised AI operating model for software teams.</p>
  </div>
</footer>

<script>
  // Mermaid is bundled (exact pin in package.json) and lazy-loaded only on
  // pages that carry diagrams — no runtime CDN calls (spec AC9). Diagrams
  // re-render on theme toggle; the raw source persists in data-mermaid.
  // A run token guards against interleaved re-renders on rapid toggling:
  // a superseded run must not overwrite a newer theme's SVG.
  let renderRun = 0;
  const renderDiagrams = async () => {
    const els = document.querySelectorAll('.mermaid-diagram[data-mermaid]');
    if (els.length === 0) return;
    const run = ++renderRun;
    const dark = document.documentElement.dataset.theme === 'dark';
    let mermaid;
    try {
      ({ default: mermaid } = await import('mermaid'));
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: dark ? 'dark' : 'neutral',
        // The dark theme leaves edge-label backgrounds light; pin them to
        // the dark surface token so labels sit flush on the diagram ground.
        themeVariables: dark ? { edgeLabelBackground: '#111726' } : {},
      });
    } catch (e) {
      console.warn('Mermaid bundle failed to load — showing raw source', e);
      for (const el of els) {
        const pre = document.createElement('pre');
        pre.textContent = decodeURIComponent(el.getAttribute('data-mermaid') ?? '');
        el.replaceChildren(pre);
      }
      return;
    }
    for (const el of els) {
      const src = decodeURIComponent(el.getAttribute('data-mermaid') ?? '');
      const id = 'mermaid-' + Math.random().toString(36).slice(2);
      try {
        const { svg } = await mermaid.render(id, src);
        if (run !== renderRun) return; // superseded by a newer toggle
        el.innerHTML = svg;
      } catch (e) {
        console.warn('Mermaid render failed', e);
      }
    }
  };
  renderDiagrams();
  // Not disconnected: this is an MPA (no view transitions), so the script
  // and observer die with the page on every navigation. If a ClientRouter
  // ever lands, disconnect on astro:before-swap.
  new MutationObserver(renderDiagrams).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
