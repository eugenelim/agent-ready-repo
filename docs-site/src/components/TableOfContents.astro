---
// Override of Starlight's TableOfContents: a guidebook step leads the
// right-hand rail with its own walk, named, above the page's headings.
//
// The global sidebar lists every guide in every pack, so it answers "where am
// I in the documentation" and structurally cannot answer "where am I in this
// walk". A reader working through a guidebook needs the second, and the right
// rail is where they are already looking for position. A page that is not a
// step renders Starlight's component alone, unchanged.
import Default from '@astrojs/starlight/components/TableOfContents.astro';
import { guidebookWalk } from './guidebook-walk';

const walk = await guidebookWalk(Astro.locals.starlightRoute.entry);
---

{
  walk && (
    <nav
      class="guidebook-walk"
      aria-label={`${walk.name} guidebook, step ${walk.step} of ${walk.steps}`}
    >
      {/* The visible eyebrow names the walk; the accessible name above repeats
          it, because `aria-labelledby` pointing at "Step 4 of 5" alone told a
          screen-reader user their position in something unnamed. */}
      <p class="walk-name">
        <code>{walk.name}</code> guidebook
      </p>
      <h2 class="walk-heading">Step {walk.step} of {walk.steps}</h2>
      <ol>
        {walk.items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              <span class="walk-number">{item.step}</span>
              <span>{item.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
<Default />

<style>
  .guidebook-walk {
    margin-bottom: 1.5rem;
  }

  .walk-heading {
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-h5);
    line-height: 1.3;
    color: var(--sl-color-white);
  }

  .walk-name {
    margin: 0 0 0.15rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: var(--sl-text-xs);
    line-height: 1.3;
    color: var(--sl-color-gray-3);
  }

  .walk-name code {
    font-size: inherit;
    background: none;
    border: none;
    padding: 0;
    color: inherit;
  }

  .guidebook-walk ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-inline-start: 1px solid var(--sl-color-hairline-light);
  }

  .guidebook-walk a {
    display: flex;
    gap: 0.5rem;
    padding: 0.3rem 0 0.3rem 1rem;
    margin-inline-start: -1px;
    border-inline-start: 1px solid transparent;
    font-size: var(--sl-text-xs);
    line-height: 1.4;
    text-decoration: none;
    color: var(--sl-color-gray-3);
  }

  .guidebook-walk a:hover {
    color: var(--sl-color-white);
  }

  .guidebook-walk a[aria-current='page'] {
    color: var(--sl-color-text-accent);
    border-inline-start-color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  .walk-number {
    flex: none;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-gray-4);
  }

  .guidebook-walk a[aria-current='page'] .walk-number {
    color: inherit;
  }
</style>
