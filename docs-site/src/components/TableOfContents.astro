---
// Override of Starlight's TableOfContents: a guidebook step leads the
// right-hand rail with its own walk, named, above the page's headings.
//
// The global sidebar lists every guide in every pack, so it answers "where am
// I in the documentation" and structurally cannot answer "where am I in this
// walk". A reader working through a guidebook needs the second, and the right
// rail is where they are already looking for position. A page that is not a
// step renders Starlight's component alone, unchanged.
import Default from '@astrojs/starlight/components/TableOfContents.astro';
import { guidebookWalk } from './guidebook-walk';

const walk = await guidebookWalk(Astro.locals.starlightRoute.entry);
---

{
  walk && (
    <nav
      class="guidebook-walk"
      aria-label={`${walk.name} guidebook, step ${walk.step} of ${walk.steps}`}
    >
      {/* The visible eyebrow names the walk; the accessible name above repeats
          it, because `aria-labelledby` pointing at "Step 4 of 5" alone told a
          screen-reader user their position in something unnamed. */}
      {/* Pinned, because the rail is a fixed 100vh scroll container: on a
          short viewport the eight-skill step overflows it by 145px, and
          scrolling the rail took the reader's only orientation off the top
          first. The step list below scrolls under this.

          The header names the guidebook and nothing else. A numeral and a
          "Step 4 of 5" line both restated the entry already marked current in
          the list immediately below — three renderings of one fact, in the
          panel with the least room for any of them. */}
      <div class="walk-header">
        <h2 class="walk-title">
          <code>{walk.name}</code> guidebook
        </h2>
      </div>
      <ol>
        {walk.items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              <span class="walk-number">{item.step}</span>
              <span>{item.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
<Default />

<style>
  .guidebook-walk {
    margin-bottom: 1.5rem;
  }

  .walk-header {
    position: sticky;
    top: 0;
    z-index: 1;
    margin-bottom: 0.6rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 8px;
    background: var(--sl-color-bg-sidebar, var(--sl-color-bg));
  }

  /* The numeral is the fastest thing to read in the rail, so it carries the
     position and the words beside it carry the meaning. Hidden from assistive
     technology because "Step 3 of 5" below already says it -- announcing a
     bare "3" first would be noise. */



  .walk-title {
    margin: 0;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.3;
    color: var(--sl-color-white);
  }

  .walk-title code {
    font-size: inherit;
    background: none;
    border: none;
    padding: 0;
    color: inherit;
  }



  .guidebook-walk ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-inline-start: 1px solid var(--sl-color-hairline-light);
  }

  .guidebook-walk a {
    display: flex;
    gap: 0.5rem;
    padding: 0.3rem 0 0.3rem 1rem;
    margin-inline-start: -1px;
    border-inline-start: 1px solid transparent;
    font-size: var(--sl-text-xs);
    line-height: 1.4;
    text-decoration: none;
    color: var(--sl-color-gray-3);
  }

  .guidebook-walk a:hover {
    color: var(--sl-color-white);
  }

  .guidebook-walk a[aria-current='page'] {
    color: var(--sl-color-text-accent);
    border-inline-start-color: var(--sl-color-text-accent);
    font-weight: 600;
  }

  .walk-number {
    flex: none;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-gray-4);
  }

</style>
