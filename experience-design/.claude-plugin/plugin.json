  "repository": "https://github.com/eugenelim/agent-ready-repo",
  "keywords": [
    "customer-journey",
    "service-blueprint",
    "interaction-design",
    "design-systems",
    "heuristic-evaluation"
  ],
  "displayName": "Experience Design"
}
