{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ready-repo.example/contracts/jsonschema/workspace-entry.schema.json",
  "title": "Target workspace entry",
  "description": "Durable workspace.toml index entry for one canonical artifact.",
  "type": "object",
  "contract_version": "workspace-entry.v1",
  "x-spec": [
    "docs/specs/normalized-intake-workspace-contracts/",
    "docs/specs/semantic-surface-resolver/",
    "docs/specs/dependency-scoped-completion-receipts/"
  ],
  "additionalProperties": false,
  "required": ["kind", "source", "summary", "needs"],
  "properties": {
    "path": {
      "$ref": "#/$defs/repositoryRelativePath"
    },
    "surface_role": {
      "$ref": "#/$defs/surfaceRole"
    },
    "locator": {
      "$ref": "#/$defs/externalLocator"
    },
    "kind": {
      "$ref": "#/$defs/artifactKind"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "needs": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/need"
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {"required": ["path"]},
        {"required": ["locator"]}
      ]
    },
    {
      "if": {"required": ["locator"]},
      "then": {"required": ["surface_role"]}
    }
  ],
  "$defs": {
    "surfaceRole": {
      "enum": [
        "delivery-brief",
        "delivery-contract",
        "current-product-truth",
        "user-documentation",
        "product-history",
        "release-history",
        "current-architecture",
        "architecture-design",
        "decision-record",
        "operations",
        "interface-contract",
        "project-knowledge",
        "runtime-coordination"
      ]
    },
    "externalLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"const": "external"},
        "value": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000,
          "pattern": "^(?!.*[\\u0000-\\u001f\\u007f])(?!.*[@?#\\s])[A-Za-z][A-Za-z0-9+.-]*:.+$"
        }
      }
    },
    "artifactKind": {
      "enum": ["intent", "research", "design", "brief", "spec", "defect"]
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!.*[\\u0000-\\u001f\\u007f])(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["repo-origin", "tracker-origin"]
        },
        "ref": {
          "$ref": "#/$defs/safeLocator"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "parent": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "coordination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "tracker_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "tracker-origin"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "required": ["ref", "revision"]
          }
        }
      ]
    },
    "need": {
      "oneOf": [
        {
          "$ref": "#/$defs/localNeed"
        },
        {
          "$ref": "#/$defs/crossRepoNeed"
        }
      ]
    },
    "localNeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "path"],
      "properties": {
        "type": {
          "const": "local"
        },
        "kind": {
          "$ref": "#/$defs/artifactKind"
        },
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delivery_id", "outcome", "completion_event", "evidence_ref"],
          "properties": {
            "delivery_id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
            },
            "outcome": {
              "enum": ["completed", "abandoned", "superseded"]
            },
            "completion_event": {
              "enum": ["merge", "release", "acceptance"]
            },
            "evidence_ref": {
              "type": "string",
              "pattern": "^(?:commit:[0-9a-f]{40}|pr:[0-9]+|run:[0-9]+)$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {"const": "defect"}
            },
            "required": ["kind"]
          },
          "then": {
            "not": {"required": ["receipt"]}
          }
        }
      ]
    },
    "crossRepoNeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "kind",
        "path",
        "containing_brief",
        "receipt_id",
        "accepted_revision"
      ],
      "properties": {
        "type": {
          "const": "cross-repo"
        },
        "kind": {
          "enum": ["brief", "spec"]
        },
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "containing_brief": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "accepted_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "safeLocator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!.*[\\u0000-\\u001f\\u007f])(?!.*\\s)[^@?#]+$"
    }
  }
}
