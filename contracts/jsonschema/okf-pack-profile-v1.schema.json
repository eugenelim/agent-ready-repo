{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ready-repo.example/contracts/jsonschema/okf-pack-profile-v1.schema.json",
  "title": "AgentBundle OKF pack profile v1",
  "description": "Closed contract for the [pack.metadata.okf] table that declares OKF 0.2 bundles and reviewed Skill projections.",
  "type": "object",
  "contract_version": "agentbundle-okf-pack-profile.v1",
  "x-spec": [
    "docs/specs/okf-authoring-projection/",
    "docs/specs/agent-skill-engineering-foundation/"
  ],
  "additionalProperties": false,
  "required": ["profile", "bundles"],
  "properties": {
    "profile": {
      "const": "agentbundle-okf/v1"
    },
    "bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/bundle"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "packRelativeOkfDirectory": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1000,
      "pattern": "^(?=okf/)(?!/)(?![A-Za-z]:)(?!.*[\\u0000-\\u001F\\u007F<>:\"|?*\\\\])(?!.*//)(?!.*\\/$)(?!\\.\\.?$)(?!\\.\\.?/)(?!.*\\/\\.\\.?(?:\\/|$))(?!.*[. ](?:\\/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?!.*\\/(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$)).+$"
    },
    "bundleRelativeFile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*[\\u0000-\\u001F\\u007F<>:\"|?*\\\\])(?!.*//)(?!.*\\/$)(?!\\.\\.?$)(?!\\.\\.?/)(?!.*\\/\\.\\.?(?:\\/|$))(?!.*[. ](?:\\/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?!.*\\/(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "projectedConcept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reviewed-projection-digest"],
      "properties": {
        "path": {
          "$ref": "#/$defs/bundleRelativeFile"
        },
        "reviewed-projection-digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "providerCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract-version",
        "domain",
        "purpose",
        "task-kinds",
        "invocation",
        "ownership-manifest"
      ],
      "properties": {
        "contract-version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}/v[1-9][0-9]*$"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[\\u0020-\\u007E]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[\\u0020-\\u007E]+$"
        },
        "task-kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "invocation": {
          "const": "explicit-workflow-only"
        },
        "ownership-manifest": {
          "const": ".okf-generated.json"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "router-skill"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "path": {
          "$ref": "#/$defs/packRelativeOkfDirectory"
        },
        "router-skill": {
          "$ref": "#/$defs/slug"
        },
        "projected-concepts": {
          "type": "array",
          "maxItems": 2000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/projectedConcept"
          }
        },
        "provider": {
          "$ref": "#/$defs/providerCapability"
        }
      }
    }
  }
}
