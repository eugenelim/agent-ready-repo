{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ready-repo.example/contracts/jsonschema/work-intake-migration-confirmation.schema.json",
  "title": "Current-session work-intake migration confirmation",
  "description": "Human-authored, single-use authorization evidence bound to one migration effect.",
  "type": "object",
  "contract_version": "work-intake-migration-confirmation.v1",
  "x-spec": ["docs/specs/work-intake-migration-docs/"],
  "additionalProperties": false,
  "required": [
    "contract_version",
    "confirmation_id",
    "action",
    "operation_id",
    "operation_digest",
    "authorization_subject",
    "role",
    "confirmed_at",
    "authorization_source"
  ],
  "properties": {
    "contract_version": {
      "const": "work-intake-migration-confirmation.v1"
    },
    "confirmation_id": {
      "type": "string",
      "pattern": "^confirmation-[a-f0-9]{32}$"
    },
    "action": {
      "enum": ["apply", "rollback"]
    },
    "operation_id": {
      "$ref": "#/$defs/operationId"
    },
    "operation_digest": {
      "$ref": "#/$defs/sha256"
    },
    "authorization_subject": {
      "type": "string",
      "pattern": "^subject-[a-f0-9]{32}$"
    },
    "role": {
      "enum": [
        "migration-approver",
        "repository-maintainer",
        "security-approver"
      ]
    },
    "confirmed_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorization_source": {
      "const": "current-human-session"
    }
  },
  "$defs": {
    "operationId": {
      "type": "string",
      "pattern": "^migration-[a-f0-9]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
