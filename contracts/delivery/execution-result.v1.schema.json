{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ready-repo.invalid/contracts/delivery/execution-result.v1.schema.json",
  "title": "execution-result.v1",
  "description": "The controller's report for one execution-request.v1. The supervisor re-derives state and refuses a result that is not for the current request; the worker's change set is measured against the current HEAD, never against fields here.",
  "$comment": "Owned by: docs/specs/execution-supervisor-core/. Architecture: docs/architecture/work-loop-execution-supervisor.md.",
  "x-spec": [
    "docs/specs/execution-supervisor-core/"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "run_id",
    "kind"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "Schema major version. Unknown versions refuse."
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "enum": [
        "implement-task",
        "write-stub",
        "run-gates",
        "review-role",
        "assess-finding",
        "external-effect",
        "effect-query",
        "regenerate",
        "human-decision"
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        }
      },
      "description": "Controller-run gate outcome."
    },
    "criteria": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_ref",
          "outcome"
        ],
        "properties": {
          "criterion_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^AC-[0-9]{4}(?![\\s\\S])"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          }
        }
      }
    },
    "report": {
      "type": "object",
      "description": "A review-report.v1 record; validated by its own canonical schema."
    },
    "assessment": {
      "type": "object",
      "description": "A finding-assessment.v1 record; validated by its own canonical schema."
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "completed",
            "not-executed",
            "running",
            "present",
            "absent",
            "unknowable"
          ]
        },
        "receipt_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Opaque reference the effect source returned, such as a remote commit id."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "implement-task"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "gate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "run-gates"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "gate",
          "criteria"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "regenerate"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "gate"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review-role"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "report"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "assess-finding"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "assessment"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "external-effect"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "effect"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "effect-query"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "effect"
        ]
      }
    }
  ]
}
