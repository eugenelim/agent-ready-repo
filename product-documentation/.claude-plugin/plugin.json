{
  "name": "product-documentation",
  "version": "0.1.2",
  "description": "Documentation that matches what actually shipped. Write, restructure, or audit READMEs, quickstarts, guides, and release notes for any library, CLI, API, app, or service, with the reader's journey showing which page is missing.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/scripts/install-marker.py\" --install-route claude-plugins",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "author": {
    "name": "eugenelim",
    "email": "eugenelim@users.noreply.github.com"
  },
  "license": "Apache-2.0 OR MIT",
  "homepage": "https://github.com/eugenelim/agent-ready-repo",
  "repository": "https://github.com/eugenelim/agent-ready-repo",
  "keywords": [
    "documentation",
    "readme",
    "changelog",
    "api-docs",
    "cli-docs"
  ],
  "displayName": "Product Documentation"
}
