---
interface Item {
  label: string;
  href?: string;
  id?: string;
}

interface Props {
  type: 'nav' | 'tabs';
  items: Item[];
  activeId?: string;
  id?: string;
}

const { type, items, activeId, id } = Astro.props;
const switcherId = id ?? `ts-${items.map((i) => i.id ?? i.label).join('-').replace(/[^a-z0-9]/gi, '-').slice(0, 20)}`;
---

{type === 'nav' ? (
  <nav class="task-switcher task-switcher--nav" aria-label="Task navigation">
    {items.map((item) => (
      <a
        class:list={['task-switcher__item', { 'task-switcher__item--active': item.id === activeId }]}
        href={item.href ?? '#'}
        aria-current={item.id === activeId ? 'page' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
) : (
  <div class="task-switcher task-switcher--tabs" data-switcher-id={switcherId}>
    <div role="tablist" class="task-switcher__tablist" aria-label="Task tabs">
      {items.map((item, i) => (
        <button
          role="tab"
          id={`${switcherId}-tab-${item.id ?? i}`}
          class:list={['task-switcher__tab', { 'task-switcher__tab--active': item.id === activeId }]}
          aria-selected={item.id === activeId ? 'true' : 'false'}
          aria-controls={`${switcherId}-panel-${item.id ?? i}`}
          tabindex={item.id === activeId ? 0 : -1}
        >
          {item.label}
        </button>
      ))}
    </div>
    {items.map((item, i) => (
      <div
        role="tabpanel"
        id={`${switcherId}-panel-${item.id ?? i}`}
        aria-labelledby={`${switcherId}-tab-${item.id ?? i}`}
        class:list={['task-switcher__panel', { 'task-switcher__panel--active': item.id === activeId }]}
        hidden={item.id !== activeId}
      >
        <slot name={item.id ?? String(i)} />
      </div>
    ))}
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('.task-switcher--tabs').forEach((switcher) => {
    const tabs = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(switcher.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    function activate(tab: HTMLButtonElement): void {
      tabs.forEach((t) => { t.setAttribute('aria-selected', 'false'); t.tabIndex = -1; });
      panels.forEach((p) => { p.hidden = true; p.classList.remove('task-switcher__panel--active'); });
      tab.setAttribute('aria-selected', 'true');
      tab.tabIndex = 0;
      tab.classList.add('task-switcher__tab--active');
      const panelId = tab.getAttribute('aria-controls');
      if (panelId) {
        const panel = document.getElementById(panelId);
        if (panel) { panel.hidden = false; panel.classList.add('task-switcher__panel--active'); }
      }
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activate(tab));
      tab.addEventListener('keydown', (e) => {
        let next: HTMLButtonElement | undefined;
        if (e.key === 'ArrowRight') next = tabs[(i + 1) % tabs.length];
        if (e.key === 'ArrowLeft')  next = tabs[(i - 1 + tabs.length) % tabs.length];
        if (next) { next.focus(); activate(next); }
      });
    });
  });
</script>

<style>
  .task-switcher--nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-1);
    border-bottom: 1px solid var(--ds-border);
  }

  .task-switcher--tabs {
    display: flex;
    flex-direction: column;
  }

  .task-switcher__tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-bottom: 1px solid var(--ds-border);
  }

  .task-switcher__item,
  .task-switcher__tab {
    padding: var(--ds-space-3) var(--ds-space-4);
    font-size: var(--ds-type-sm);
    font-weight: var(--ds-weight-medium);
    color: var(--ds-on-surface-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
    cursor: pointer;
    transition: color var(--ds-dur-quick) var(--ds-ease-std),
                border-color var(--ds-dur-quick) var(--ds-ease-std);
    min-height: 44px;
  }

  .task-switcher__item:hover,
  .task-switcher__tab:hover {
    color: var(--ds-on-surface);
  }

  .task-switcher__item--active,
  .task-switcher__tab--active,
  .task-switcher__tab[aria-selected="true"] {
    color: var(--ds-accent-deep);
    border-bottom-color: var(--ds-accent);
  }

  .task-switcher__item:focus-visible,
  .task-switcher__tab:focus-visible {
    outline: 2px solid var(--ds-accent);
    outline-offset: -2px;
  }

  .task-switcher__panel {
    padding: var(--ds-space-5) 0;
  }

  .task-switcher__panel[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .task-switcher__item,
    .task-switcher__tab { transition: none; }
  }
</style>
