---
import ReadWriteBadge from './ReadWriteBadge.astro';
import CoverageBadge from './CoverageBadge.astro';
import PermissionBadge from './PermissionBadge.astro';

type ReadWriteMode = 'read-only' | 'draft' | 'proposed-write' | 'confirmed-write' | 'publish' | 'destructive';
type CoverageState = 'complete' | 'filtered' | 'partial' | 'capped' | 'permission-limited';
type AccessState = 'granted' | 'missing' | 'unknown';

type PageMetaItem =
  | { type: 'mode'; value: ReadWriteMode }
  | { type: 'coverage'; value: CoverageState; detail?: string }
  | { type: 'permission'; permission: string; access: AccessState }
  | { type: 'skill'; name: string }
  | { type: 'prerequisite'; label: string };

interface Props {
  items: PageMetaItem[];
}

const { items } = Astro.props;
---

{/* Native <ul>/<li> rather than role="list"/role="listitem" on generic
    elements: identical accessibility tree, no ARIA to keep in sync. The
    explicit role="list" stays because base.css sets `list-style: none` on
    every list, which makes Safari/VoiceOver drop list semantics. As of
    2026-09-18 that is the rule for every list in `web/src`, not a per-
    component choice — base.css states the obligation and
    src/test/list-semantics.test.ts enforces it. */}
<ul class="page-meta" role="list" aria-label="Page metadata">
  {items.map((item) => (
    <li class="page-meta__item">
      {item.type === 'mode' && <ReadWriteBadge mode={item.value} />}
      {item.type === 'coverage' && <CoverageBadge coverage={item.value} detail={item.detail} />}
      {item.type === 'permission' && <PermissionBadge permission={item.permission} access={item.access} />}
      {item.type === 'skill' && (
        <span class="page-meta__skill">{item.name}</span>
      )}
      {item.type === 'prerequisite' && (
        <span class="page-meta__prereq">{item.label}</span>
      )}
    </li>
  ))}
</ul>

<style>
  .page-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-3);
    align-items: center;
  }

  .page-meta__item {
    display: inline-flex;
    align-items: center;
  }

  .page-meta__skill {
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-xs);
    color: var(--ds-field-label);
    border: 1px solid var(--ds-rule-hairline);
    padding: 0.25rem 0.5rem;
    border-radius: var(--ds-radius-sm);
    text-transform: uppercase;
    letter-spacing: var(--ds-track-label);
  }

  .page-meta__prereq {
    font-size: var(--ds-type-xs);
    color: var(--ds-on-surface-muted);
  }
</style>
