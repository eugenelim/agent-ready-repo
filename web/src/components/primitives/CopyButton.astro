---
interface Props {
  content?: string;
  label?: string;
  successLabel?: string;
  class?: string;
}

const {
  content = '',
  label = 'Copy',
  successLabel = 'Copied!',
  class: className,
} = Astro.props;
---

<button
  class:list={['copy-btn', className]}
  type="button"
  aria-label={label}
  data-copy-content={content}
  data-copy-label={label}
  data-copy-success={successLabel}
>
  <span class="copy-btn__icon" aria-hidden="true">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="4" y="4" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.25"/>
      <path d="M2 10V2.5A1.5 1.5 0 0 1 3.5 1H10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
    </svg>
  </span>
  <span class="copy-btn__label">{label}</span>
  <span class="copy-btn__live" aria-live="polite" aria-atomic="true"></span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    const lbl = btn.querySelector<HTMLElement>('.copy-btn__label');
    const live = btn.querySelector<HTMLElement>('.copy-btn__live');
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copyContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const success = btn.dataset.copySuccess ?? 'Copied!';
        if (lbl) lbl.textContent = success;
        if (live) live.textContent = success;
        btn.classList.add('copy-btn--success');
        setTimeout(() => {
          if (lbl) lbl.textContent = btn.dataset.copyLabel ?? 'Copy';
          if (live) live.textContent = '';
          btn.classList.remove('copy-btn--success');
        }, 2000);
      } catch {
        // The clipboard write can fail for reasons the reader cannot see:
        // an insecure origin, a denied permission, or a browser that has no
        // Clipboard API. The button silently doing nothing is the worst of
        // the three outcomes, so say so. The live region already exists and
        // already works — this is the message it was missing.
        const failed = 'Copy failed — select the text and copy it yourself';
        if (lbl) lbl.textContent = failed;
        if (live) live.textContent = failed;
        setTimeout(() => {
          if (lbl) lbl.textContent = btn.dataset.copyLabel ?? 'Copy';
          if (live) live.textContent = '';
        }, 4000);
      }
    });
  });
</script>

<style>
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--ds-space-2);
    /* Themable slots so a dark-zone host (the install terminal) can retint the
       button by setting custom properties on an ancestor. Component-scoped
       selectors cannot reach across the component boundary; inherited custom
       properties can. */
    background: var(--copy-btn-bg, transparent);
    border: 1px solid var(--copy-btn-border, var(--ds-border));
    border-radius: var(--ds-radius-sm);
    color: var(--copy-btn-fg, var(--ds-on-surface-muted));
    font-size: var(--ds-type-xs);
    font-family: var(--ds-font-mono);
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    transition: color var(--ds-dur-quick) var(--ds-ease-std),
                border-color var(--ds-dur-quick) var(--ds-ease-std);
    min-height: 44px;
    min-width: 44px;
  }

  .copy-btn:hover {
    background: var(--copy-btn-bg-hover, var(--copy-btn-bg, transparent));
    color: var(--copy-btn-fg-hover, var(--ds-on-surface));
    /* Themable so a dark-zone host (the install terminal) can supply the record
       white instead; the default is heading ink because this button's own
       default styling renders on the light zone (CopyPrompt). The withdrawn
       accent is gone from both ends — hover is carried by ink weight and a
       darkened border, not hue. */
    border-color: var(--copy-btn-border-hover, var(--ds-on-surface));
  }

  .copy-btn:active {
    background-color: var(--ds-surface-pressed);
      /* Muted rest ink measures 3.50:1 on the pressed ground. Raised, keeping the
       host override this component exposes for every other colour. */
    color: var(--copy-btn-fg-active, var(--ds-on-surface));
}

  .copy-btn:focus-visible {
    outline: 2px solid var(--ds-focus-ring);
    outline-offset: 3px;
  }

  .copy-btn--success {
    background: var(--copy-btn-bg-success, var(--copy-btn-bg, transparent));
    color: var(--copy-btn-fg-success, var(--ds-state-success-fg));
    border-color: var(--copy-btn-border-success, var(--ds-state-success-border));
  }

  .copy-btn__live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-btn { transition: none; }
  }

  /* Paper: a copy-to-clipboard control cannot be pressed on a sheet, and the
     text it would copy is printed beside it already. Scoped here for the
     specificity reason given in SiteNav.astro. */
  @media print {
    .copy-btn {
      display: none;
    }
  }
</style>
