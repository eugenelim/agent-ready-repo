---
// ZONE 7 — START IN ONE COMMAND. Paper (surface-alt), and the terminal block
// inside it is PAPER TOO. It was the last dark device left on the page, and
// the dark ground appears exactly once on this surface, at the close
// (docs/design/direction/marketing-site.md, Owner decisions 2026-09-18). What
// made it read as a terminal was the fill; what makes it read as a command
// record now is the boundary rule and the mono face, which is [ruled]
// containment doing the job [flat] material forbids a fill from doing.
// CSS-only tabs via a radio
// group — zero JavaScript for tab switching, keyboard-navigable (arrow keys
// move between radios). Copy button uses a small JS snippet that reads the
// currently-checked radio to collect the active panel's commands.
import Section from '../layout/Section.astro';
import CopyButton from '../primitives/CopyButton.astro';
import { withBase } from '../../lib/paths';

const tabs = [
  { id: 'flagship', label: 'Flagship loop', lines: ['python -m pip install agentbundle', 'agentbundle install --pack core'] },
  { id: 'discovery', label: 'With discovery', lines: ['agentbundle install --pack core', 'agentbundle install --pack product-engineering --scope user'] },
  { id: 'inception', label: 'Full inception', lines: ['agentbundle install --profile inception'] },
  { id: 'architect', label: 'Solution architect', lines: ['agentbundle install --profile solution-architect'] },
];
---

<Section tone="surface-alt" id="install" labelledby="install-heading">
  <h2 id="install-heading" class="install__headline">Start in one command.</h2>

  <div class="terminal">
    <div class="terminal__bar">
      {/* The three chrome dots are gone with the dark fill. They were a
          picture of a terminal window, and on a paper record they are
          ornament with no job — which [none] ornament forbids and [flat]
          material does not need. The bar keeps its rule and the copy
          control, which are the parts that do something. */}
      <p class="terminal__label">Install</p>
      <CopyButton class="install-copy-btn" label="Copy install commands" />
    </div>

    <div class="tabs" role="group" aria-label="Install options">
      {tabs.map((t, i) => (
        <>
          <input
            class="tabs__radio"
            type="radio"
            name="install-tabs"
            id={`install-tab-${t.id}`}
            checked={i === 0}
          />
          <label class="tabs__label" for={`install-tab-${t.id}`}>{t.label}</label>
        </>
      ))}

      <div class="tabs__panels">
        {tabs.map((t) => (
          <div class={`tabs__panel tabs__panel--${t.id}`} data-label={t.label}>
            {t.lines.map((line) => (
              <div class="terminal__line">
                <span class="terminal__prompt" aria-hidden="true">❯ </span><code>{line}</code>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>

  <p class="install__note">
    One command lands the loop. Any agent that reads a skill file inherits it automatically.
    Follow the <a href={withBase('/docs/guides/#the-install-to-ship-walkthrough')}>install-to-ship walkthrough</a>.
  </p>
</Section>

<script>
  // Sync data-copy-content on the CopyButton whenever the active tab changes.
  // CopyButton's own script handles the actual clipboard write.
  const copyBtn = document.querySelector<HTMLButtonElement>('.install-copy-btn');

  function getActiveCommands(): string {
    const checked = document.querySelector<HTMLInputElement>('.tabs__radio:checked');
    if (!checked) return '';
    const id = checked.id.replace('install-tab-', '');
    const panel = document.querySelector(`.tabs__panel--${id}`);
    if (!panel) return '';
    return Array.from(panel.querySelectorAll('code'))
      .map((c) => c.textContent ?? '')
      .join('\n');
  }

  function syncContent(): void {
    if (copyBtn) copyBtn.dataset.copyContent = getActiveCommands();
  }

  // Sync on load and whenever a radio changes.
  syncContent();
  document.querySelectorAll<HTMLInputElement>('.tabs__radio').forEach((radio) => {
    radio.addEventListener('change', syncContent);
  });
</script>

<style>
  .install__headline {
    margin-bottom: var(--ds-space-6);
  }

  /* --ds-rule-boundary measures 3.26:1 on --ds-surface-alt, which is this
     band's ground, so the block's own edge clears WCAG 1.4.11. */
  .terminal {
    background-color: var(--ds-surface);
    border: 1px solid var(--ds-rule-boundary);
    border-radius: var(--ds-radius-lg);
    overflow: hidden;
    max-width: 760px;
  }

  .terminal__bar {
    display: flex;
    align-items: center;
    gap: var(--ds-space-2);
    padding: var(--ds-space-3) var(--ds-space-4);
    border-bottom: 1px solid var(--ds-rule-hairline);
  }

  /* A field label where the chrome dots were: it names the record instead
     of picturing a window. --ds-field-label measures 5.30:1 on
     --ds-surface. */
  .terminal__label {
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ds-field-label);
  }

  /* The dark-zone retint of CopyButton is DELETED, not adjusted. Every
     property in it pointed at a `--ds-hero-*` token, and the whole block
     existed because this carrier was dark; the carrier is paper now, so the
     premise is gone and CopyButton's own light-zone defaults are already the
     right ones (--ds-on-surface-muted 5.30:1 on --ds-surface, --ds-border
     for the edge, --ds-on-surface on hover). Re-adding a themed slot here
     would put a dark-ground value on a paper ground, which is the exact
     inversion of the 3.43:1 defect the deleted block was written to fix. */

  .terminal__bar :global(.copy-btn.install-copy-btn) {
    margin-left: auto;
  }

  /* ── CSS-only tabs ─────────────────────────────────────────────────── */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  /* Radios stay in the tab order for keyboard use, but are visually hidden. */
  .tabs__radio {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .tabs__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--ds-space-3) var(--ds-space-5);
    font-size: var(--ds-type-sm);
    font-weight: var(--ds-weight-medium);
    color: var(--ds-on-surface-muted);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    user-select: none;
    box-sizing: border-box;
  }

  .tabs__label:hover {
    color: var(--ds-on-surface-2);
  }

  .tabs__label:active {
    background-color: var(--ds-surface-pressed);
  }

  .tabs__panels {
    flex-basis: 100%;
    width: 100%;
    border-top: 1px solid var(--ds-rule-hairline);
  }

  .tabs__panel {
    display: none;
    padding: var(--ds-space-5) var(--ds-space-5) var(--ds-space-6);
    color: var(--ds-on-surface);
    overflow-x: auto;
  }

  .terminal__line {
    white-space: nowrap;
    line-height: var(--ds-lead-mono);
  }

  .terminal__line code {
    color: var(--ds-on-surface);
    background: none;
  }

  /* 600, not 700: mono ships 400 and 600 only (see fonts.css), so 700 would
     resolve to 600 and the declaration would describe something that does
     not happen. */
  .terminal__prompt {
    color: var(--ds-on-surface-muted);
    font-weight: var(--ds-weight-semibold);
    font-family: var(--ds-font-mono);
  }

  /* Active tab label + its panel, driven by the checked radio. */
  #install-tab-flagship:checked ~ .tabs__panels .tabs__panel--flagship,
  #install-tab-discovery:checked ~ .tabs__panels .tabs__panel--discovery,
  #install-tab-inception:checked ~ .tabs__panels .tabs__panel--inception,
  #install-tab-architect:checked ~ .tabs__panels .tabs__panel--architect {
    display: block;
  }

  #install-tab-flagship:checked + .tabs__label,
  #install-tab-discovery:checked + .tabs__label,
  #install-tab-inception:checked + .tabs__label,
  /* The active tab is carried by ink weight AND the 2px rule under it, not
     by colour alone. --ds-on-surface measures 17.16:1 for the label and
     17.16:1 for the rule against --ds-surface. */
  #install-tab-architect:checked + .tabs__label {
    color: var(--ds-on-surface);
    font-weight: var(--ds-weight-semibold);
    border-bottom-color: var(--ds-on-surface);
  }

  /* Keyboard focus lands on the (hidden) radio — surface it on the label. */
  .tabs__radio:focus-visible + .tabs__label {
    outline: 2px solid var(--ds-focus-ring);
    outline-offset: -2px;
  }

  .install__note {
    margin-top: var(--ds-space-5);
    color: var(--ds-on-surface-muted);
    max-width: 60ch;
  }

  /* text-decoration now comes from the global `a` rule in base.css; this
     link keeps its own color (muted, inherited from .install__note rather
     than the global on-surface) and a wider underline offset. */
  .install__note a {
    color: inherit;
    text-underline-offset: 0.18em;
  }

  @media (prefers-reduced-motion: reduce) {
    .install-copy-btn {
      transition: none;
    }
  }

  /* Paper: the variant is chosen by a radio the reader cannot click, so three
     of the four panels printed as display:none and the sheet carried one of
     four install routes with no sign the others existed. All four print, each
     under its own label. `data-label` carries it because the tab strip is a
     sibling <label> set that no selector can pair with a panel. Scoped here for
     the specificity reason given in SiteNav.astro. */
  @media print {
    .tabs__radio,
    .tabs__label {
      display: none;
    }

    .tabs__panel {
      display: block;
      margin-bottom: var(--ds-rule-pitch);
      break-inside: avoid;
    }

    .tabs__panel::before {
      content: attr(data-label);
      display: block;
      margin-bottom: var(--ds-rule-pitch);
      font-family: var(--ds-font-mono);
      font-size: var(--ds-type-mono-xs);
      font-weight: var(--ds-weight-semibold);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ds-on-surface-muted);
    }
  }
</style>
