---
// Section 1 — HERO. Dark zone (--ds-hero-bg), full-bleed, continuous with the
// nav above and the stat strip below. Radial amber glow + faint grid texture
// (matching the MkDocs hero). One-shot 300ms opacity fade-in on load, guarded
// by prefers-reduced-motion. No looping animation (creative-direction.md).
import { withBase } from '../../lib/paths';
---

<section class="hero">
  <div class="hero__inner">
    <h1 class="hero__headline">The agentic build loop that cannot approve its own work.</h1>
    <p class="hero__subhead">
      <code>core</code> takes a brief or spec through implementation, mechanical gates,
      and a cold independent review. It keeps going until the change is clean—or stops
      and tells you why. The wider catalogue brings the same discipline to product,
      design, infrastructure, release, research, and documentation work.
    </p>
    <div class="hero__actions">
      <a class="hero__cta hero__cta--primary" href={withBase('/#install')}>
        Try the supervised build loop <span aria-hidden="true">→</span>
      </a>
      <a class="hero__cta hero__cta--ghost" href={withBase('/#use-cases')}>
        Explore use cases <span aria-hidden="true">→</span>
      </a>
    </div>
    <p class="hero__friction">
      One command. Every major coding agent. Human merge gate. User-scope packs also
      ship through the <a href={withBase('/docs/getting-started/install/#route-2-claude-plugins')}>Claude plugin marketplace</a>.
    </p>
  </div>
</section>

<style>
  .hero {
    background-color: var(--ds-hero-bg);
    background-image:
      radial-gradient(ellipse 70% 60% at 50% 0%, var(--ds-accent-glow) 0%, transparent 65%),
      linear-gradient(var(--ds-hero-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--ds-hero-border) 1px, transparent 1px);
    background-size: 100% 100%, 28px 28px, 28px 28px;
    color: var(--ds-hero-fg);
  }

  .hero__inner {
    max-width: var(--ds-content-max);
    margin-inline: auto;
    padding: clamp(3.5rem, 8vw, 6rem) var(--ds-content-pad-x) var(--ds-space-8);
  }

  .hero__headline {
    color: var(--ds-hero-fg);
    max-width: 18ch;
    margin-bottom: var(--ds-space-5);
  }

  .hero__subhead {
    color: var(--ds-hero-fg-2);
    font-size: var(--ds-type-body-lg);
    max-width: 60ch;
    margin-bottom: var(--ds-space-6);
  }

  .hero__subhead code {
    background: none;
    color: var(--ds-accent);
    font-family: var(--ds-font-mono);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-3);
  }

  .hero__cta {
    display: inline-block;
    padding: 0.7rem 1.6rem;
    border-radius: var(--ds-radius-pill);
    font-weight: var(--ds-weight-semibold);
    font-size: var(--ds-type-body);
    border: 1px solid transparent;
  }

  .hero__cta:hover {
    text-decoration: none;
  }

  .hero__cta--primary {
    background-color: var(--ds-cta-primary-bg);
    color: var(--ds-cta-primary-fg);
    border-color: var(--ds-cta-primary-bg);
  }

  .hero__cta--primary:hover {
    background-color: var(--ds-cta-primary-bg-hover);
    border-color: var(--ds-cta-primary-bg-hover);
  }

  /* Secondary action reads as a link, not a second primary. Two filled-weight
     buttons side by side gave the zone no focal point; the pill treatment is
     reserved for the one action we actually want taken. Keeps a 44px touch
     height. */
  .hero__cta--ghost {
    background-color: transparent;
    color: var(--ds-cta-ghost-fg);
    border-color: transparent;
    font-weight: var(--ds-weight-medium);
    /* No inline padding: the link's left edge lines up with the primary
       pill's. `gap` restores the space before the arrow that inline-flex
       collapses out of the markup's whitespace text node. */
    padding-inline: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
  }

  .hero__cta--ghost:hover {
    color: var(--ds-hero-fg);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ── Mobile: get the primary CTA above the fold ────────────────────────
     At 390×844 the display-scale headline plus an 18px four-sentence deck
     pushed the primary CTA roughly 450px below the fold. Step both down and
     tighten the top padding; no new tokens, and desktop is untouched. */
  @media (max-width: 768px) {
    .hero__inner {
      padding-top: var(--ds-space-7);
    }

    .hero__headline {
      font-size: var(--ds-type-h2);
      max-width: 22ch;
      margin-bottom: var(--ds-space-4);
    }

    .hero__subhead {
      font-size: var(--ds-type-body);
      margin-bottom: var(--ds-space-5);
    }

    .hero__actions {
      gap: var(--ds-space-2);
    }
  }

  /* One-shot fade-in on load — 300ms, guarded. Static by default for
     reduced-motion (content is visible without the animation). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__inner {
      animation: hero-fade var(--ds-dur-gentle) var(--ds-ease-out) both;
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .hero__friction {
    font-size: var(--ds-type-xs);
    color: var(--ds-hero-fg-muted);
    margin-top: var(--ds-space-3);
    margin-bottom: 0;
  }

  .hero__friction a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
</style>
