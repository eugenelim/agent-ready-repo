---
// Section 1 — Pack hero for journey pages. Light zone (no dark band on journey
// pages — journey pages are light zone: the record). Weight comes from record
// ink and ruled boundaries; chroma is reserved for clearance and functional
// state, so nothing here is tinted.
import { withBase } from '../../lib/paths';
import StatusChip from '../primitives/StatusChip.astro';

interface Props {
  name: string;
  scope: 'user' | 'repo';
  tagline: string;
  skillCount: number;
  humanTouches: number;
  wallClockMinutes: string;
  packUrl: string;
  docsUrl: string;
}

const { name, scope, tagline, skillCount, humanTouches, wallClockMinutes, packUrl, docsUrl } = Astro.props;
---

<header class="journey-hero">
  <div class="journey-hero__inner">
    <div class="journey-hero__meta">
      <StatusChip label={scope} />
    </div>
    <h1 class="journey-hero__name">{name}</h1>
    <p class="journey-hero__tagline">{tagline}</p>
    {/* `role="group"`. The `aria-label` was on a bare <div>, whose implicit
        role is `generic`, and ARIA in HTML forbids a name on `generic` — every
        assistive technology DROPS it, so the label was rendering to nobody.
        `group` is the role this actually is: a set of related stats read as a
        unit, named once. */}
    <div class="journey-hero__stats" role="group" aria-label="Session statistics">
      <span class="stat"><strong>{skillCount}</strong> skills</span>
      {/* The separator is grouped WITH the stat that follows it, not left
          loose between two. Loose, the line could break after it and leave a
          bare "·" dangling at the end of a line — measured at the supported
          320 minimum, where this row wraps. Grouped, the break happens before
          the separator instead, so a wrapped line starts with "· 2 human
          gates" and reads as a continuation. The spans stay `aria-hidden`
          rather than becoming CSS `::before` content, which some screen
          readers announce. */}
      <span class="stat-run"><span class="stat-sep" aria-hidden="true">·</span> <span class="stat"><strong>{humanTouches}</strong> {humanTouches === 1 ? 'human gate' : 'human gates'}</span></span>
      <span class="stat-run"><span class="stat-sep" aria-hidden="true">·</span> <span class="stat"><strong>{wallClockMinutes}</strong> min/session</span></span>
    </div>
    <div class="journey-hero__actions">
      <a class="btn-primary" href={withBase(packUrl)}>Install this pack <span aria-hidden="true">→</span></a>
      <a class="btn-ghost" href={withBase(docsUrl)}>Read the reference <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</header>

<style>
  .journey-hero {
    background-color: var(--ds-surface-alt);
    border-bottom: 1px solid var(--ds-border);
    padding-block: var(--ds-space-9);
  }

  .journey-hero__inner {
    max-width: var(--ds-content-max);
    margin-inline: auto;
    padding-inline: var(--ds-content-pad-x);
  }

  .journey-hero__meta {
    margin-bottom: var(--ds-space-4);
  }

  .journey-hero__name {
    font-size: var(--ds-type-display);
    font-weight: var(--ds-weight-heavy);
    color: var(--ds-on-surface);
    letter-spacing: var(--ds-track-display);
    line-height: var(--ds-lead-display);
    margin-bottom: var(--ds-space-4);
  }

  .journey-hero__tagline {
    font-size: var(--ds-type-body-lg);
    color: var(--ds-on-surface-2);
    max-width: 60ch;
    line-height: var(--ds-lead-body);
    margin-bottom: var(--ds-space-5);
  }

  .journey-hero__stats {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--ds-space-2);
    margin-bottom: var(--ds-space-7);
    font-size: var(--ds-type-body);
    color: var(--ds-on-surface-muted);
  }

  .stat strong {
    color: var(--ds-on-surface);
    font-weight: var(--ds-weight-semibold);
  }

  .stat-sep {
    color: var(--ds-on-surface-muted);
  }

  /* Binds a separator to the stat it introduces. `nowrap` is safe here because
     the longest run is "· 12 min/session" — measured at 320, it fits the band
     with room to spare, and the row still wraps between runs. */
  .stat-run {
    white-space: nowrap;
  }

  .journey-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-4);
    align-items: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    box-sizing: border-box;
    gap: var(--ds-space-2);
    background-color: var(--ds-cta-primary-bg);
    color: var(--ds-cta-primary-fg);
    font-weight: var(--ds-weight-semibold);
    padding: 0.5rem 1.6rem;
    border-radius: var(--ds-radius-md);
    text-decoration: none;
    transition: background-color var(--ds-dur-moderate) var(--ds-ease-std);
  }

  .btn-primary:hover {
    background-color: var(--ds-cta-primary-bg-hover);
  }

  .btn-primary:active {
    background-color: var(--ds-cta-primary-bg-active);
      /* A press lands at once. These controls inherit a 120-200ms ease on the
       property the press moves, and a click is commonly shorter than that, so
       the ground never reached full value before release — measured at 5.5% of
       the way there on the first frame. Release still eases, because leaving
       :active uses the base rule. Snap in, ease out, and `[still]` motion. */
    transition: none;
}

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    box-sizing: border-box;
    gap: var(--ds-space-2);
    color: var(--ds-cta-ghost-light-fg);
    font-weight: var(--ds-weight-semibold);
    padding: 0.5rem 1.6rem;
    border-radius: var(--ds-radius-md);
    border: 1px solid var(--ds-cta-ghost-light-border);
    text-decoration: none;
    transition: background-color var(--ds-dur-moderate) var(--ds-ease-std);
  }

  .btn-ghost:hover {
    background-color: var(--ds-border);
  }

  .btn-ghost:active {
    background-color: var(--ds-surface-pressed);
      /* A press lands at once. These controls inherit a 120-200ms ease on the
       property the press moves, and a click is commonly shorter than that, so
       the ground never reached full value before release — measured at 5.5% of
       the way there on the first frame. Release still eases, because leaving
       :active uses the base rule. Snap in, ease out, and `[still]` motion. */
    transition: none;
}

  @media (prefers-reduced-motion: reduce) {
    .btn-primary,
    .btn-ghost {
      transition: none;
    }
  }
</style>
