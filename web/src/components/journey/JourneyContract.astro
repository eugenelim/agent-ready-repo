---
// Compact above-the-fold contract for a journey page (journey-template-revamp).
// Use it when / You type / You provide / You receive / Your decisions — so a
// reader learns the shape once and reuses it on every journey. `youType` is
// optional and its row is omitted when a journey has not declared one, so a
// pack authored before the field still renders. Light zone, record rule on the
// leading edge, same --ds-* token vocabulary as GateDetail.astro. Zero JS.

interface Contract {
  useItWhen: string;
  youType?: string;
  youProvide: string;
  youReceive: string;
  decisionGateIds?: string[];
  yourDecisions?: string[];
}

interface Gate {
  id: string;
  label: string;
}

interface Props {
  contract: Contract;
  humanGates: Gate[];
}

const { contract, humanGates } = Astro.props;
const gatesById = new Map(humanGates.map((gate) => [gate.id, gate]));
const decisions = contract.decisionGateIds?.map((id) => gatesById.get(id));
const decisionCount = decisions?.length ?? 0;
---

<div class="contract-card">
  <dl class="contract-list">
    <div class="contract-row">
      <dt>Use it when</dt>
      <dd>{contract.useItWhen}</dd>
    </div>
    {contract.youType && (
      <div class="contract-row">
        <dt>You type</dt>
        <dd><code>{contract.youType}</code></dd>
      </div>
    )}
    <div class="contract-row">
      <dt>You provide</dt>
      <dd>{contract.youProvide}</dd>
    </div>
    <div class="contract-row">
      <dt>You receive</dt>
      <dd>{contract.youReceive}</dd>
    </div>
  </dl>

  <section class="contract-decisions" aria-labelledby="where-you-decide">
    <h3 id="where-you-decide">Where you decide</h3>
    <p>The agent pauses at these points. You choose whether to continue, redirect, or stop.</p>
    <div class="decision-chip-list">
      {decisions?.map((gate, index) => gate && (
        <a class="decision-chip" href={`#decision-${gate.id}`}>
          <span>{gate.label}</span>
          <span class="decision-chip__ordinal">Decision {index + 1} of {decisionCount}</span>
        </a>
      ))}
      {!decisions && contract.yourDecisions?.map((decision) => (
        <span class="decision-chip">{decision}</span>
      ))}
    </div>
  </section>
</div>

{decisions && (
  <script is:inline>
    const focusDecisionTarget = () => {
      if (!window.location.hash.startsWith('#decision-')) return;
      const target = document.getElementById(decodeURIComponent(window.location.hash.slice(1)));
      if (target instanceof HTMLElement) {
        target.focus({ preventScroll: true });
        target.scrollIntoView({ block: 'start' });
      }
    };

    window.addEventListener('hashchange', focusDecisionTarget);
    focusDecisionTarget();
  </script>
)}

<style>
  .contract-card {
    background-color: var(--ds-surface-alt);
    border: 1px solid var(--ds-border);
    border-left: 1px solid var(--ds-rule-boundary);
    border-radius: var(--ds-radius-md);
    padding: var(--ds-space-6);
    max-width: 72ch;
  }

  .contract-list {
    display: grid;
    gap: var(--ds-space-4);
  }

  .contract-row {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--ds-space-2) var(--ds-space-5);
    align-items: baseline;
  }

  .contract-row dt {
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-xs);
    text-transform: uppercase;
    letter-spacing: var(--ds-track-label);
    color: var(--ds-field-label);
    font-weight: var(--ds-weight-semibold);
  }

  .contract-row dd {
    font-size: var(--ds-type-body);
    color: var(--ds-on-surface-2);
    line-height: var(--ds-lead-body);
  }

  .contract-decisions {
    margin-top: var(--ds-space-5);
    padding-top: var(--ds-space-5);
    border-top: 1px solid var(--ds-border);
  }

  .contract-decisions h3 {
    color: var(--ds-on-surface);
    font-size: var(--ds-type-h3);
    margin-bottom: var(--ds-space-2);
  }

  .contract-decisions p {
    color: var(--ds-on-surface-2);
    margin-bottom: var(--ds-space-4);
  }

  .decision-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-3);
  }

  /* Resting decision chip. It opts out of the base underline, so its
     affordance has to be non-chromatic and non-textual: a ruled, padded box
     set in the mono field face, carrying its own ordinal label. The accent
     tint that used to do this work is withdrawn. Hover and focus invert the
     chip to solid record ink — a fill change, not a hue change — which is the
     same treatment `.gate-card__label` uses, so one interaction speaks one
     language. */
  .decision-chip {
    display: grid;
    gap: var(--ds-space-1);
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-mono-sm);
    /* Boundary rule, not the hairline every static chip takes: this chip is a
       link that opts out of the base underline, so its border is what
       identifies it as a control and owes WCAG 1.4.11's 3:1 floor. The
       hairline measured 1.91:1 on `--ds-surface-alt`; this measures 3.12:1. */
    border: 1px solid var(--ds-rule-boundary);
    color: var(--ds-on-surface-2);
    padding: 0.25rem 0.6rem;
    border-radius: var(--ds-radius-sm);
    text-decoration: none;
  }

  .decision-chip:hover,
  .decision-chip:focus-visible {
    /* Neutral ink fill, not the chroma accent. The register withdraws
       chroma everywhere except the clearance stamp (register palette
       amendment); a vermilion hover fill was left over from the prior
       accent-driven palette and measured 3.14:1 against its near-black
       text — below the 4.5:1 floor. `--ds-on-surface` (record-900) with
       `--ds-surface` (record-50) text measures ~15.7:1, comfortably clear.
       axe cannot see this: it scans the resting DOM, so a :hover/
       :focus-visible rule never applies during the scan.
       `assertStateContrast` in the browser gate covers it. */
    background-color: var(--ds-on-surface);
    border-color: var(--ds-on-surface);
    color: var(--ds-surface);
  }

  .decision-chip:focus-visible {
    outline: 3px solid var(--ds-focus-ring);
    outline-offset: 3px;
  }

  .decision-chip__ordinal {
    font-size: var(--ds-type-xs);
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* Stack labels above values on narrow viewports. */
  @media (max-width: 640px) {
    .contract-row {
      grid-template-columns: 1fr;
      gap: var(--ds-space-1);
    }
  }
</style>
