---
// Footer — dark zone. Labelled column groups rather than a flat link row: this
// is the last thing on every marketing page, and a three-link strip was
// carrying none of the site's navigable surface. The generated projection is
// the renderer-local input derived from the approved destination contract.
import marketingChrome from '../../lib/shared-chrome.generated.json';
import { chromeHref, currentState, type ChromeLink } from '../../lib/shared-chrome';

const year = new Date().getFullYear();
// Printed only. Every other destination on a sheet is a root-relative path, so
// without the origin none of them is followable. Read from `site` via Astro
// rather than retyped, so it cannot drift from the deployed origin.
const origin = Astro.site ? Astro.site.origin : '';

const columns = marketingChrome.footer;
const current = (link: ChromeLink) =>
  currentState(link, Astro.url.pathname, import.meta.env.BASE_URL);
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brandcol">
      <p class="footer__brand">agent-ready-repo</p>
      <p class="footer__tag">The supervised AI operating model for software teams.</p>
    </div>

    <nav class="footer__cols" aria-label="Footer">
      {columns.map((col) => (
        <div class="footer__col">
          <h2 class="footer__collabel">{col.label}</h2>
          <ul class="footer__list" role="list">
            {col.destinations.map((link) => (
              <li>
                <a href={chromeHref(link)} aria-current={current(link)}>
                  {link.label}{link.kind === 'external' && <><span aria-hidden="true"> ↗</span><span class="visually-hidden"> external</span></>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>

    <p class="footer__copy">© {year} · agent-ready-repo</p>
    {origin && <p class="footer__origin">Printed from {origin}</p>}
  </div>
</footer>

<style>
  /* Print-only. Revealed by the `@media print` block at the foot of this file;
     on screen the origin is the address bar's job. */
  .footer__origin {
    display: none;
  }

  .footer {
    background-color: var(--ds-hero-bg);
    color: var(--ds-hero-fg-muted);
  }

  .footer__inner {
    max-width: var(--ds-content-max);
    margin-inline: auto;
    padding: var(--ds-space-8) var(--ds-content-pad-x) var(--ds-space-7);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--ds-space-7) var(--ds-space-8);
  }

  /* 600, not 700: mono ships 400 and 600 only (see fonts.css). */
  .footer__brand {
    font-family: var(--ds-font-mono);
    font-weight: var(--ds-weight-semibold);
    color: var(--ds-hero-fg);
  }

  .footer__tag {
    margin-top: var(--ds-space-2);
    font-size: var(--ds-type-sm);
    color: var(--ds-hero-fg-muted);
    max-width: 34ch;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ds-space-6);
  }

  .footer__collabel {
    font-size: var(--ds-type-xs);
    font-weight: var(--ds-weight-semibold);
    /* Sentence case, minimal tracking — a field label, not a decorative
       uppercase eyebrow (docs/design/direction/tech-site-amendment-palette.md).
       Kept on --ds-hero-fg (not --ds-field-label): that token is tuned for
       the light zone and would fail contrast on this dark footer. */
    letter-spacing: 0.02em;
    color: var(--ds-hero-fg);
    margin-bottom: var(--ds-space-3);
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--ds-space-2);
  }

  .footer__list a {
    color: var(--ds-hero-fg-2);
    font-size: var(--ds-type-sm);
  }

  .footer__list a:hover {
    color: var(--ds-hero-fg);
    text-decoration: none;
  }

  .footer__list a:active {
    background-color: var(--ds-surface-pressed-dk);
  }

  .footer__list a[aria-current] {
    color: var(--ds-hero-fg);
    font-weight: var(--ds-weight-semibold);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .footer__copy {
    grid-column: 1 / -1;
    padding-top: var(--ds-space-5);
    border-top: 1px solid var(--ds-hero-border);
    font-size: var(--ds-type-sm);
    color: var(--ds-hero-fg-muted);
  }

  @media (max-width: 768px) {
    .footer__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--ds-space-6);
    }

    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--ds-space-5) var(--ds-space-4);
    }

    /* 44px rows so the column links are real touch targets on a phone. */
    .footer__list a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }

    .footer__list {
      gap: 0;
    }
  }

  /* Paper. The dark ground is 0.82 of an A4 sheet in solid ink, and with
     background graphics off -- the print dialog's default -- it does not print
     while its foreground does, leaving 1.42:1 text on white. The 2026-09-18
     owner decision composes the SCREEN page; paper ground with ink text is that
     decision translated to a medium that decides for itself whether to paint a
     background. The link columns are navigation and go; the brand, tagline and
     copyright are identity and stay. Scoped here for the specificity reason
     given in SiteNav.astro. */
  @media print {
    .footer {
      background-color: var(--ds-surface);
      color: var(--ds-on-surface-2);
      border-top: 1px solid var(--ds-rule-boundary);
    }

    .footer__cols {
      display: none;
    }

    .footer__brand,
    .footer__copy {
      color: var(--ds-on-surface);
    }

    /* Every other destination on the sheet prints as a root-relative path, so
       the origin has to appear once for any of them to be followable. */
    .footer__origin {
      display: block;
      margin-top: var(--ds-rule-pitch);
      font-family: var(--ds-font-mono);
      font-size: var(--ds-type-mono-xs);
      color: var(--ds-on-surface-muted);
    }
  }
</style>
