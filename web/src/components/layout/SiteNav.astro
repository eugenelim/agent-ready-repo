---
// Primary navigation. PAPER — continuous with the hero below it, no gap. The
// dark ground appears exactly once on the surface, at the close, and this is
// not it (docs/design/direction/marketing-site.md, Owner decisions 2026-09-18
// § "The nav and footer move to paper").
// The bar's lower boundary is a RULE, not a change of ground: it is what tells
// a sighted reader where the chrome ends and the page begins, and it is the
// line an aria-current state is read against, so it is a user-interface
// component boundary owing 3:1 under WCAG 1.4.11 rather than a decorative
// divider owing nothing. --ds-rule-boundary measures 3.53:1 on --ds-surface.
// Mobile menu is a <details>/<summary> disclosure: zero JavaScript.
// Nav structure:
//   Logo | approved shared destinations | [Try the build loop →]
import { withBase } from '../../lib/paths';
import marketingChrome from '../../lib/shared-chrome.generated.json';
import { chromeHref, currentState, splitHeader, type ChromeLink } from '../../lib/shared-chrome';

const homeHref = withBase('/');
// The CTA is selected by its stable ID, not by falling last in the order.
const { links, cta } = splitHeader(marketingChrome.header);
const current = (link: ChromeLink) =>
  currentState(link, Astro.url.pathname, import.meta.env.BASE_URL);
---

<nav class="nav" aria-label="Primary">
  <div class="nav__inner">
    <a class="nav__logo" href={homeHref}>agent-ready-repo</a>

    <ul class="nav__links" role="list">
      {links.map((l) => (
        <li><a class="nav__link" href={chromeHref(l)} aria-current={current(l)}>{l.label}</a></li>
      ))}
      <li>
        <a class="nav__cta" href={chromeHref(cta)}>{cta.label} <span aria-hidden="true">→</span></a>
      </li>
    </ul>

    <details class="nav__mobile">
      <summary class="nav__toggle" aria-label="Toggle navigation menu">
        <span class="nav__burger" aria-hidden="true"></span>
      </summary>
      <ul class="nav__drawer" role="list">
        {links.map((l) => (
          <li><a class="nav__link" href={chromeHref(l)} aria-current={current(l)}>{l.label}</a></li>
        ))}
        <li>
          <a class="nav__cta" href={chromeHref(cta)}>{cta.label} <span aria-hidden="true">→</span></a>
        </li>
      </ul>
    </details>
  </div>
</nav>

<style>
  .nav {
    background-color: var(--ds-surface);
    color: var(--ds-on-surface);
    position: relative;
  }

  .nav__inner {
    max-width: var(--ds-content-max);
    margin-inline: auto;
    padding: var(--ds-space-4) var(--ds-content-pad-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ds-space-5);
    border-bottom: 1px solid var(--ds-rule-boundary);
  }

  /* Opt out of the base underline: the wordmark is the only bold mono
     700-weight run in the bar and owns the top-left slot. Channel = weight +
     typeface + position, not colour. */
  .nav__logo {
    text-decoration: none;
    color: var(--ds-on-surface);
    /* 600, not 700: mono ships two weights now and 700 falls back to 600
       anyway — stating it is what keeps the declaration honest. */
    font-weight: var(--ds-weight-semibold);
    font-size: var(--ds-type-body-lg);
    letter-spacing: var(--ds-track-heading);
    font-family: var(--ds-font-mono);
  }

  .nav__logo:hover {
    text-decoration: none;
    color: var(--ds-on-surface-2);
  }

  .nav__logo:active {
    background-color: var(--ds-surface-pressed);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--ds-space-6);
    margin: 0;
  }

  /* Opt out of the base underline: a nav row is its own affordance — five
     evenly spaced items in the bar, at 500 against 400 body text, with the
     current page additionally underlined below. Channel = position in the
     nav group + weight, not colour. */
  .nav__link {
    text-decoration: none;
    color: var(--ds-on-surface-2);
    font-size: var(--ds-type-sm);
    font-weight: var(--ds-weight-medium);
  }

  .nav__link:hover {
    color: var(--ds-on-surface);
    text-decoration: none;
  }

  .nav__link:active {
    background-color: var(--ds-surface-pressed);
  }

  .nav__link[aria-current] {
    color: var(--ds-on-surface);
    font-weight: var(--ds-weight-semibold);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  /* Opt out of the base underline: this is a filled pill. Channel = fill +
     radius + padding, not colour. (inline-block, so the markup's whitespace
     before the arrow survives — no `gap` needed here.) */
  .nav__cta {
    text-decoration: none;
    display: inline-block;
    background-color: var(--ds-cta-primary-bg);
    color: var(--ds-cta-primary-fg);
    font-size: var(--ds-type-sm);
    font-weight: var(--ds-weight-semibold);
    padding: 0.5rem 1.1rem;
    border-radius: var(--ds-radius-md);
    /* A BORDER in the fill's own colour, so the control's edge is drawn twice
       — once as fill, once as a border — and survives a repaint that keeps
       only one of them. Invisible here (border and fill are the same ink);
       load-bearing under `forced-colors: active`, which forces every
       `background-color` to Canvas and would otherwise leave this control as
       an undecorated run of LinkText with no fill, no border and, because it
       opts out of the underline above, no non-colour affordance at all.
       Measured under Chromium's forced-colors emulation, 2026-09-18: the
       border repaints to LinkText and the block edge comes back. Same
       pattern, same reason, as `.hero__cta--primary`. */
    border: 1px solid var(--ds-cta-primary-bg);
  }

  .nav__cta:hover {
    background-color: var(--ds-cta-primary-bg-hover);
    border-color: var(--ds-cta-primary-bg-hover);
    text-decoration: none;
  }

  .nav__cta:active {
    background-color: var(--ds-cta-primary-bg-active);
  }

  /* ── Mobile disclosure — hidden on desktop ─────────────────────────── */
  .nav__mobile {
    display: none;
  }

  .nav__toggle {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
  }

  .nav__toggle::-webkit-details-marker {
    display: none;
  }

  .nav__burger,
  .nav__burger::before,
  .nav__burger::after {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--ds-on-surface);
    content: '';
    position: relative;
  }

  .nav__burger::before {
    position: absolute;
    top: -7px;
  }

  .nav__burger::after {
    position: absolute;
    top: 7px;
  }

  /* The three bars are PAINTED, not bordered — a 2px-high box filled with
     `background-color` — and that is the one drawing technique on this
     surface that `forced-colors: active` erases: it forces every
     `background-color` to Canvas, so all three bars go white on white and
     the only route into the mobile menu disappears at every width below
     768px. Verified against Chromium's forced-colors emulation at 390px,
     2026-09-18: without this block `getComputedStyle` reports
     `rgb(255, 255, 255)` on the bar and its two pseudo-elements.
     `CanvasText` is the system pair for the forced ground, so the icon comes
     back at full contrast whichever high-contrast theme is in use.
     The X state is untouched on purpose: `.nav__mobile[open] .nav__burger`
     below is more specific, and `transparent` is one of the few colours
     forced-colors preserves, so the middle bar still drops out when open. */
  @media (forced-colors: active) {
    .nav__burger,
    .nav__burger::before,
    .nav__burger::after {
      background-color: CanvasText;
    }
  }

  /* X state: move icon regardless of motion preference; transition is motion-only. */
  .nav__mobile[open] .nav__burger {
    background-color: transparent;
  }

  .nav__mobile[open] .nav__burger::before {
    transform: translateY(7px) rotate(45deg);
  }

  .nav__mobile[open] .nav__burger::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav__burger,
    .nav__burger::before,
    .nav__burger::after {
      transition: transform var(--ds-dur-quick) var(--ds-ease-std),
                  background-color var(--ds-dur-quick) var(--ds-ease-std);
    }
  }

  .nav__drawer {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 0;
  }

  @media (max-width: 768px) {
    .nav__links {
      display: none;
    }

    .nav__mobile {
      display: block;
    }

    /* Drawer breaks out of the row and spans full width below the bar. */
    .nav__drawer {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background-color: var(--ds-surface);
      /* The drawer overlays the page, so its own edges have to be visible
         against the paper it covers — a white-alpha hairline composites to
         ~1.1:1 here and would leave the panel edgeless. */
      border-bottom: 1px solid var(--ds-rule-boundary);
      padding: var(--ds-space-5) var(--ds-content-pad-x) var(--ds-space-6);
      z-index: var(--ds-z-overlay);
    }

    /* Drawer rows are full-width targets, not 17px-tall inline chips stacked
       in a column. Each row spans the drawer and clears the 44px touch
       minimum. Scoped to the breakpoint alongside .nav__cta — the drawer only
       exists below it. */
    .nav__drawer .nav__link {
      display: flex;
      align-items: center;
      /* Flex collapses the markup's whitespace text node, so the space before
         a trailing arrow glyph has to come back as a gap. */
      gap: 0.4em;
      width: 100%;
      min-height: 44px;
      padding-block: var(--ds-space-2);
      border-bottom: 1px solid var(--ds-rule-hairline);
    }

    .nav__drawer .nav__cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4em;
      min-height: 44px;
      margin-top: var(--ds-space-4);
    }
  }

  /* Paper. A4's 717 CSS px is below the 768 breakpoint, so this nav resolves to
     its mobile form and printed a hamburger: a closed disclosure control that
     shows the reader nothing and hides the links it holds. None of it can be
     operated on paper, so the wordmark stays as a masthead and the rest goes.
     Scoped here rather than in styles/print.css because Astro scopes these
     selectors with a `data-astro-cid-*` attribute, which outranks any global
     rule of the same class -- the override has to live at the same specificity
     or it silently loses. See styles/print.css for the page-level rules. */
  @media print {
    .nav__links,
    .nav__mobile,
    .nav__cta {
      display: none;
    }

    .nav {
      border-bottom: 1px solid var(--ds-rule-boundary);
    }
  }
</style>
