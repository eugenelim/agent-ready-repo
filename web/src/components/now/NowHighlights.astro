---
// The body of the public Now surface: released highlights, or the empty state.
//
// `spec/site-now-surface`. Extracted from the page so BOTH branches can be
// rendered in a test. The empty state (AC8) is the branch an adopter fork with
// no released Highlights lands on, and while it lived inline in the page it could
// only be checked by grepping the template for its strings — which cannot catch
// a broken link.
import { withBase } from '../../lib/paths';
import { releaseLabel as releaseLabelOf, readableDate } from '../../lib/now-release';

export interface HighlightSegment {
  readonly type: 'text' | 'strong' | 'code';
  readonly value: string;
}

export interface NowHighlight {
  readonly source: string;
  readonly segments: readonly HighlightSegment[];
}

export interface NowGroup {
  readonly packages: readonly { readonly name: string; readonly version: string }[];
  readonly date: string;
  readonly heading: string;
  readonly changelogAnchor: string;
  readonly highlights: readonly NowHighlight[];
}

interface Props {
  groups: readonly NowGroup[];
}

const { groups } = Astro.props;

const changelogHref = withBase('/docs/changelog/');

// Shared with the permalink route and the Atom feed — see lib/now-release.ts.
// They were local consts until the permalink route made this the third caller.
const releaseLabel = (group: NowGroup) => releaseLabelOf(group.packages);

// One index entry per distinct release date, pointing at the FIRST release of
// that day. Groups arrive in the contract's descending-date order, so first-seen
// is the topmost release for that date and a `Map` preserves that order.
// Deliberately not one entry per release: 156 links is a second long page, not
// an index. Deliberately not one per month either — the whole history currently
// spans two calendar months, so a month index would have two entries and
// navigate nothing.
const dateIndex = [...groups
  .reduce((acc, group) => (
    acc.has(group.date) ? acc : acc.set(group.date, group.changelogAnchor)
  ), new Map<string, string>())
  .entries()]
  .map(([date, anchor]) => ({ date, anchor, label: readableDate(date) }));

// A release count per date, so the index says how much sits under each entry
// rather than making the reader jump to find out.
const releasesOn = groups.reduce((acc, group) => (
  acc.set(group.date, (acc.get(group.date) ?? 0) + 1)
), new Map<string, number>());
---

{groups.length === 0 ? (
  <div class="now-empty">
    <p class="now-empty__text">No released highlights yet.</p>
    <a class="now-empty__link" href={changelogHref}>Read the changelog</a>
  </div>
) : (
  <Fragment>
    <nav class="now-index" aria-labelledby="now-index-heading">
      <h3 id="now-index-heading" class="now-index__heading">Jump to a date</h3>
      <ol class="now-index__list" role="list">
        {dateIndex.map((entry) => (
          <li class="now-index__item">
            <a class="now-index__link" href={`#${entry.anchor}`}>
              <span class="now-index__date">{entry.label}</span>
              <span class="now-index__count">{releasesOn.get(entry.date)}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <ol class="now-list" role="list">
    {groups.map((group) => (
      <li class="now-release" id={group.changelogAnchor}>
        <div class="now-release__meta">
          <h3 class="now-release__name">
            <a class="now-release__link" href={withBase(`/now/${group.changelogAnchor}/`)}
              >{releaseLabel(group)}</a>
          </h3>
          <time class="now-release__date" datetime={group.date}>{readableDate(group.date)}</time>
        </div>
        <ul class="now-release__highlights" role="list">
          {group.highlights.map((highlight) => (
            <li class="now-highlight">
              {highlight.segments.map((segment) => (
                segment.type === 'strong' ? <strong>{segment.value}</strong>
                : segment.type === 'code' ? <code>{segment.value}</code>
                : <Fragment>{segment.value}</Fragment>
              ))}
            </li>
          ))}
        </ul>
        <a
          class="now-release__source"
          href={`${changelogHref}#${group.changelogAnchor}`}
        >Release notes for {releaseLabel(group)}</a>
      </li>
    ))}
    </ol>

    <a class="now-totop" href="#now-heading">Back to the top</a>
  </Fragment>
)}

<style>
  /* ── Releases ──────────────────────────────────────────────────────────
     A ruled record list, not a stack of tinted boxes. The release used to
     carry `--ds-surface-alt`, a border and `--ds-radius-md`, which
     contradicted three axes of the direction sheet at once: `[ruled]`
     containment ("rules divide and rank; no cards, no tinted panels"),
     `[flat]` material ("separation comes from rules, space and alignment")
     and `[none]` ornament. The homepage's outcome band had exactly the same
     contradiction and it was resolved the same way; this surface is one
     route from it, so the two now read as one site.

     The shape is PackCatalogue's `.work-records` / `.work-record` and
     WhatYouInstall's `.units__list` / `.unit`: rules on the record's TOP
     edge, the list closing on its own bottom rule, and space doing the work
     the padding box used to do. --ds-rule-boundary measures 3.53:1 on
     --ds-surface, which is this band's ground. */

  /* `minmax(0, 1fr)`, not the implicit `auto` track. A grid item's automatic
     minimum size is its MIN-CONTENT size, and a grid track is not clamped by
     its container, so the release grew to whatever its longest unbreakable
     run demanded and pushed the page past the viewport. Measured at the
     supported 320px minimum: document scrollWidth 349 against a 320 client
     width — a live WCAG 1.4.10 Reflow failure, and the same state as 1280px
     at 400% zoom. Stating the track minimum as 0 lets the release shrink to
     the band. Retained through the restyle: dropping the fill and the border
     does not change a track's intrinsic minimum. */
  .now-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-bottom: 1px solid var(--ds-rule-boundary);
  }

  /* Vertical rhythm is now padding on the record, not a grid `gap` between
     boxes: a gap would put daylight between a record and the rule that is
     supposed to bound it. */
  .now-release {
    padding-block: var(--ds-space-6);
    border-top: 1px solid var(--ds-rule-hairline);
  }

  .now-release:first-child {
    border-top: 1px solid var(--ds-rule-boundary);
  }

  .now-release__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--ds-space-2) var(--ds-space-4);
    margin-bottom: var(--ds-space-4);
  }

  /* A <h3>, not a <span>, since 2026-09-22: 156 releases shared ONE heading on
     this page, so a screen-reader user could not skim it by heading and nothing
     could be linked to. The element changed; the rendering did not — `margin: 0`
     clears the UA heading default and the size below was already explicit. */
  /* The heading links to the release's own page. The `id` stays on the <li>
     as well: it is what the in-page date index jumps to, and dropping it would
     break that index to gain nothing. */
  .now-release__link {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .now-release__name {
    margin: 0;
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-sm);
    font-variant-numeric: tabular-nums lining-nums;
    font-weight: var(--ds-weight-semibold);
    color: var(--ds-on-surface);
  }

  .now-release__date {
    font-size: var(--ds-type-xs);
    text-transform: uppercase;
    letter-spacing: var(--ds-track-label);
    color: var(--ds-on-surface-2);
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* ── The date index ────────────────────────────────────────────────────
     The finding this closes named three absences: no pagination, no in-page
     contents, no return-to-top. This is the contents and the return. Bounding
     the page is a separate decision, recorded in
     docs/product/research/release-feed-length-survey.md.
     Ruled, not boxed — the same containment rule the release list follows. */
  .now-index {
    margin-bottom: var(--ds-space-7);
    padding-bottom: var(--ds-space-6);
    border-bottom: 1px solid var(--ds-rule-boundary);
  }

  .now-index__heading {
    margin: 0 0 var(--ds-space-4);
    font-size: var(--ds-type-xs);
    font-weight: var(--ds-weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--ds-track-label);
    color: var(--ds-field-label);
  }

  /* `auto-fill` with a floor, not a fixed column count: the index grows with
     the release history, and at the supported 320 minimum it has to collapse
     to one column without a media query. */
  .now-index__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--ds-space-2) var(--ds-space-5);
  }

  .now-index__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ds-space-3);
    padding-block: var(--ds-space-1);
    font-size: var(--ds-type-sm);
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--ds-on-surface-2);
    text-underline-offset: 0.2em;
  }

  .now-index__link:hover {
    color: var(--ds-on-surface);
  }

  /* The count is metadata about the row, so it recedes; it still clears the
     4.5:1 text floor — --ds-on-surface-muted measures 5.30:1 on --ds-surface,
     which is this band's ground. */
  .now-index__count {
    font-size: var(--ds-type-xs);
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--ds-on-surface-muted);
  }

  /* A link, not a fixed overlay. A sticky control would be ornament on a
     surface whose direction sheet reads [flat] material and [none] ornament,
     and it would cover content at the 320 minimum. One link at the foot is
     weak on a page this long, which is an argument for bounding the page
     rather than for a floating button. */
  .now-totop {
    display: inline-block;
    margin-top: var(--ds-space-6);
    font-size: var(--ds-type-sm);
    color: var(--ds-on-surface-2);
  }

  .now-release__highlights {
    margin: 0 0 var(--ds-space-5);
    padding-left: var(--ds-space-5);
    display: grid;
    gap: var(--ds-space-4);
  }

  /* The second half of the 320px reflow fix, and it is load-bearing on its
     own — clamping the track alone only moves the overflow inside the box.
     The arithmetic, recomputed against the ruled layout: at 320px the
     horizontal margin is `clamp(1.25rem, 5vw, 2.5rem)` = 20px a side, so the
     band is 280px; the record no longer has horizontal padding, so this
     list's 16px indent (below 640px) leaves 264px for the text — 72px more
     than the 192px the boxed layout left. The longest highlight's
     min-content width is 239px, an unbreakable identifier, so it still
     overruns a 320px band without this declaration and no amount of track
     clamping helps.

     `anywhere` rather than `break-word` because only `anywhere` is counted
     in intrinsic sizing: `break-word` would still report a 239px min-content
     and the grid item would still be sized by it. Precedent on this surface
     is `.hero__proof`, which carries the same declaration for the same
     reason. It is inherited, so the `<code>` and `<strong>` runs inside a
     highlight break too. */
  .now-highlight {
    font-size: var(--ds-type-body);
    color: var(--ds-on-surface-2);
    line-height: var(--ds-lead-body);
    overflow-wrap: anywhere;
  }

  .now-highlight strong {
    color: var(--ds-on-surface);
    font-weight: var(--ds-weight-semibold);
  }

  .now-release__source {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    font-size: var(--ds-type-sm);
    font-weight: var(--ds-weight-medium);
  }

  /* Below the first canonical breakpoint the record's vertical padding and
     the highlight indent both step down one stop. The indent is the measure
     argument: it returns 8px to a 320px band's text column. The vertical
     step is rhythm, not reflow — 32px of padding above and below each record
     is generous on a phone where the rule is already doing the separating. */
  @media (max-width: 640px) {
    .now-release {
      padding-block: var(--ds-space-5);
    }

    .now-release__highlights {
      padding-left: var(--ds-space-4);
    }
  }

  /* ── Empty state ───────────────────────────────────────────────────────
     Same treatment, and for the same reason. This is the branch an adopter
     fork with no released Highlights lands on, so it is the first thing that
     reader sees on this route; rendering it as the one tinted, rounded panel
     on a paper surface would make the fork's empty site look like a
     different site. Bounded by the same pair of rules a one-record list
     would be, so the two branches occupy the same shape. */
  .now-empty {
    padding-block: var(--ds-space-6);
    border-top: 1px solid var(--ds-rule-boundary);
    border-bottom: 1px solid var(--ds-rule-boundary);
  }

  .now-empty__text {
    font-size: var(--ds-type-body-lg);
    color: var(--ds-on-surface);
    margin-bottom: var(--ds-space-4);
  }

  .now-empty__link {
    font-size: var(--ds-type-body);
    font-weight: var(--ds-weight-medium);
  }
</style>