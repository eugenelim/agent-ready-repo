---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../components/layout/SiteLayout.astro';
import PackHero from '../../components/pack/PackHero.astro';
import Section from '../../components/layout/Section.astro';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const packs = await getCollection('packs');
  return packs.map((entry) => ({
    params: { pack: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const hasJourney = !!data.journeyUrl;

const MARKETPLACE = 'agent-ready-repo';
const packSlug = entry.id.replace(/\.md$/, '');
const pluginInstallCmd = `claude plugin install ${packSlug}@${MARKETPLACE}`;

// Per-pack structured data. The homepage's own note said /packs/* and
// /journeys/* were "a separate piece of work"; this is the /packs/* half.
//
// `SoftwareApplication` for the same reason the homepage uses it: a pack is a
// thing you install and run, not an organisation. It is the type Google still
// supports — its rich-results gallery lists "Software app" and no longer lists
// `HowTo`, which is why the /journeys/* half is NOT done here and is left as a
// decision rather than assumed to be worth the markup.
//
// `featureList` carries the skills. That is the property's actual meaning — the
// capabilities the application offers — and it keeps the claim derived from
// `data.skills` rather than restated, so a skill added to the pack cannot leave
// the structured data behind.
//
// `offers` at price 0 is declared for the same reason as the homepage: the
// software rich result needs one of offers / aggregateRating / review, and a
// free price is the only one of the three this repository can state as fact.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: data.name,
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Agent skill pack',
  operatingSystem: 'macOS, Linux, Windows',
  url: new URL(Astro.url.pathname, Astro.site).href,
  description: data.tagline,
  featureList: data.skills,
  softwareHelp: {
    '@type': 'WebPage',
    name: `${data.name} documentation`,
    url: new URL(withBase(data.docsUrl), Astro.site).href,
  },
  isPartOf: {
    '@type': 'SoftwareApplication',
    name: 'agent-ready-repo',
    url: new URL(withBase('/'), Astro.site).href,
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<SiteLayout
  title={`${data.name} pack — agent-ready-repo`}
  description={data.tagline}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
    is:inline
  />
  <PackHero
    name={data.name}
    scope={data.scope}
    tagline={data.tagline}
    skillCount={data.skills.length}
  />

  <Section tone="surface">
    <div class="pack-body">
      <!-- Description -->
      <div class="pack-description">
        <Content />
      </div>

      <!-- Skills -->
      <div class="pack-section">
        <h2 class="pack-section__title">Skills in this pack</h2>
        <ul class="skills-list" role="list">
          {data.skills.map((skill) => (
            <li class="skill-item">
              <code class="skill-name">{skill}</code>
            </li>
          ))}
        </ul>
      </div>

      <!-- Install -->
      <div class="pack-section">
        <h2 class="pack-section__title">Install</h2>

        <!-- agentbundle route -->
        <p class="install-route-label">Via agentbundle CLI</p>
        <div class="install-block">
          <pre class="install-block__code"><code>{data.installCommand}</code></pre>
        </div>
        <p class="install-note">
          Requires <a href={withBase('/docs/getting-started/')}>agentbundle</a>.
        </p>

        <!-- Claude plugin route — offered only for packs whose allowed-scopes
             admits "user". The route installs at user scope, so advertising it
             for a repo-scoped pack offers an install the pack forbids. -->
        {data.pluginInstallable ? (
          <>
            <p class="install-route-label install-route-label--spaced">Via Claude Code / Claude Desktop</p>
            <div class="install-block">
              <div class="install-block__plugin-row">
                <pre class="install-block__code install-block__code--light"><code>{pluginInstallCmd}</code></pre>
                <button
                  class="install-copy-btn"
                  data-cmd={pluginInstallCmd}
                  aria-label="Copy Claude plugin install command"
                  type="button"
                >Copy</button>
              </div>
            </div>
            <p class="install-note">
              No extra tooling required — works directly in <a href="https://claude.ai/code" rel="noopener noreferrer">Claude Code</a> or Claude Desktop.
              {' '}<a href={withBase('/catalogue/')}>Browse the catalogue →</a>
            </p>
          </>
        ) : (
          <p class="install-note">
            This pack installs into a repository, not across your machine, so it
            is not offered as a Claude plugin. Use the command above.
            {' '}<a href={withBase('/catalogue/')}>Browse the catalogue →</a>
          </p>
        )}
      </div>

      <!-- Journey -->
      <div class="pack-section">
        <h2 class="pack-section__title">Journey</h2>
        {hasJourney ? (
          <a class="journey-link" href={withBase(data.journeyUrl!)}>
            <div class="journey-link__inner">
              <span class="journey-link__label">Explore the {data.name} journey</span>
              <span class="journey-link__sub">See what it's like to use this pack — staged narrative with gate-by-gate guidance.</span>
            </div>
            <span class="journey-link__arrow" aria-hidden="true">→</span>
          </a>
        ) : (
          <div class="journey-coming-soon">
            <span class="journey-coming-soon__label">Journey coming soon</span>
            <p class="journey-coming-soon__sub">The narrative walkthrough for this pack is being authored. Check back after Phase 2.</p>
          </div>
        )}
      </div>

      <!-- Docs -->
      <div class="pack-section">
        <a class="docs-link" href={withBase(data.docsUrl)}>
          Read the full reference <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </Section>
</SiteLayout>

<style>
  .pack-body {
    max-width: 72ch;
    display: grid;
    gap: var(--ds-space-9);
  }

  .pack-description {
    font-size: var(--ds-type-body-lg);
    color: var(--ds-on-surface-2);
    line-height: var(--ds-lead-body);
  }

  /* Markdown is rendered as child content, so the global reset removes its
     native rhythm unless these descendants receive an explicit prose contract. */
  .pack-description :global(h2),
  .pack-description :global(h3) {
    margin-top: var(--ds-space-7);
    margin-bottom: var(--ds-space-3);
    font-size: var(--ds-type-h3);
    color: var(--ds-on-surface);
  }

  .pack-description :global(h2:first-child),
  .pack-description :global(h3:first-child) {
    margin-top: 0;
  }

  .pack-description :global(p + p) {
    margin-top: var(--ds-space-4);
  }

  .pack-description :global(ul),
  .pack-description :global(ol) {
    display: grid;
    gap: var(--ds-space-3);
    margin-top: var(--ds-space-3);
    padding-left: var(--ds-space-6);
  }

  .pack-description :global(ul) {
    list-style: disc;
  }

  .pack-description :global(ol) {
    list-style: decimal;
  }

  .pack-description :global(ul + p),
  .pack-description :global(ol + p),
  .pack-description :global(blockquote + p),
  .pack-description :global(pre + p),
  .pack-description :global(table + p) {
    margin-top: var(--ds-space-4);
  }

  .pack-description :global(strong) {
    color: var(--ds-on-surface);
    font-weight: var(--ds-weight-semibold);
  }

  .pack-description :global(blockquote) {
    margin-top: var(--ds-space-5);
    padding: var(--ds-space-4) var(--ds-space-5);
    background-color: var(--ds-surface-alt);
    border-left: 1px solid var(--ds-rule-boundary);
    border-radius: var(--ds-radius-sm);
  }

  .pack-description :global(hr) {
    margin-block: var(--ds-space-7);
    border: 0;
    border-top: 1px solid var(--ds-border);
  }

  .pack-description :global(code) {
    padding: 0.25rem 0.4rem;
    color: var(--ds-on-surface);
    border: 1px solid var(--ds-rule-hairline);
    border-radius: var(--ds-radius-sm);
  }

  .pack-description :global(pre),
  .pack-description :global(table) {
    display: block;
    max-width: 100%;
    margin-top: var(--ds-space-5);
    overflow-x: auto;
  }

  .pack-description :global(pre) {
    padding: var(--ds-space-5) var(--ds-space-6);
    color: var(--ds-hero-fg);
    background-color: var(--ds-hero-bg);
    border-radius: var(--ds-radius-md);
  }

  .pack-description :global(pre code) {
    padding: 0;
    color: inherit;
    background: none;
  }

  .pack-description :global(th),
  .pack-description :global(td) {
    padding: var(--ds-space-3) var(--ds-space-4);
    border-bottom: 1px solid var(--ds-border);
    text-align: left;
    vertical-align: top;
  }

  .pack-section__title {
    font-size: var(--ds-type-h3);
    margin-bottom: var(--ds-space-4);
    color: var(--ds-on-surface);
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-3);
  }

  .skill-item {
    list-style: none;
  }

  .skill-name {
    display: inline-block;
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-mono-sm);
    border: 1px solid var(--ds-rule-hairline);
    color: var(--ds-on-surface-2);
    padding: 0.25rem 0.6rem;
    border-radius: var(--ds-radius-sm);
  }

  /* PAPER. A command block is a FIELD on the page, not a second ground: the
     dark ground appears exactly once, at the close (marketing-site.md, Owner
     decisions 2026-09-18). What made it read as a block was the fill; what
     makes it read as a field now is the boundary rule, which is the
     direction's [ruled] containment. --ds-rule-boundary measures 3.53:1 on
     --ds-surface and 3.26:1 on --ds-surface-alt, clearing WCAG 1.4.11 on
     either band this block lands in. */
  .install-block {
    background-color: var(--ds-surface);
    border: 1px solid var(--ds-rule-boundary);
    border-radius: var(--ds-radius-md);
    padding: var(--ds-space-5) var(--ds-space-6);
    margin-bottom: var(--ds-space-3);
  }

  .install-block__code {
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-mono-sm);
    color: var(--ds-on-surface);
    line-height: var(--ds-lead-mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    margin: 0;
  }

  .install-note {
    font-size: var(--ds-type-sm);
    color: var(--ds-on-surface-muted);
  }

  .install-route-label {
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-xs);
    text-transform: uppercase;
    letter-spacing: var(--ds-track-label);
    color: var(--ds-on-surface-muted);
    margin-bottom: var(--ds-space-2);
  }

  .install-route-label--spaced {
    margin-top: var(--ds-space-5);
  }

  .install-block__plugin-row {
    display: flex;
    align-items: center;
    gap: var(--ds-space-3);
    min-width: 0;
  }

  .install-block__code--light {
    flex: 1;
    min-width: 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .install-block__plugin-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .install-copy-btn {
      align-self: flex-start;
    }
  }

  .install-copy-btn {
    flex-shrink: 0;
    background-color: var(--ds-hero-elevated);
    border: 1px solid var(--ds-hero-border-card);
    border-radius: var(--ds-radius-sm);
    color: var(--ds-hero-fg-muted);
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-xs);
    font-weight: var(--ds-weight-medium);
    padding: 0.25rem 0.7rem;
    cursor: pointer;
    transition:
      background-color var(--ds-dur-quick) var(--ds-ease-std),
      color var(--ds-dur-quick) var(--ds-ease-std),
      border-color var(--ds-dur-quick) var(--ds-ease-std);
  }

  .install-copy-btn:hover {
    border-color: var(--ds-hero-fg);
    color: var(--ds-hero-fg);
  }

  .install-copy-btn:active {
    background-color: var(--ds-surface-pressed-dk);
      /* On the dark close band the rest ink is the MUTED on-dark ink, which measures
       2.92:1 on the pressed ground. Raised to the primary on-dark ink: 6.76:1. */
    color: var(--ds-hero-fg);
}

  /* Confirmed copy. The button's own label swaps to "Copied!" in the click
     handler, so the state is announced in words; the visual channel here is a
     filled inversion — record ground behind machine ink — which hover never
     produces, so the two states cannot be confused without colour.

     The doubled class is load-bearing. A click leaves the pointer ON the
     button, so `:hover` is still matching when the success class lands; at
     equal weight the more specific hover rule won, and it sets the text to the
     same white this rule sets the fill to. Measured white-on-white, 1:1, for
     the full two seconds the confirmation is up. Both selectors are needed:
     the plain one for a keyboard activation with no pointer over the button. */
  .install-copy-btn.install-copy-btn--success,
  .install-copy-btn.install-copy-btn--success:hover {
    background-color: var(--ds-hero-fg);
    border-color: var(--ds-hero-fg);
    color: var(--ds-hero-bg);
  }

  @media (prefers-reduced-motion: reduce) {
    .install-copy-btn {
      transition: none;
    }
  }

  .journey-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ds-space-4);
    background-color: var(--ds-surface-alt);
    border: 1px solid var(--ds-border);
    border-left: 1px solid var(--ds-rule-boundary);
    border-radius: var(--ds-radius-md);
    padding: var(--ds-space-6);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--ds-dur-moderate) var(--ds-ease-std);
  }

  .journey-link:hover {
    border-color: var(--ds-on-surface);
    border-left-color: var(--ds-on-surface);
  }

  .journey-link:active {
    background-color: var(--ds-surface-pressed);
  }

  .journey-link__label {
    display: block;
    font-weight: var(--ds-weight-semibold);
    font-size: var(--ds-type-body-lg);
    color: var(--ds-on-surface);
    margin-bottom: var(--ds-space-2);
  }

  .journey-link__sub {
    font-size: var(--ds-type-sm);
    color: var(--ds-on-surface-muted);
    line-height: var(--ds-lead-body);
  }

  .journey-link__arrow {
    font-size: var(--ds-type-h3);
    color: var(--ds-on-surface);
    flex-shrink: 0;
  }

  .journey-coming-soon {
    background-color: var(--ds-surface-alt);
    border: 1px solid var(--ds-border);
    border-radius: var(--ds-radius-md);
    padding: var(--ds-space-6);
  }

  .journey-coming-soon__label {
    display: inline-block;
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-xs);
    text-transform: uppercase;
    letter-spacing: var(--ds-track-label);
    background-color: var(--ds-border);
    color: var(--ds-on-surface-muted);
    padding: 0.25rem 0.5rem;
    border-radius: var(--ds-radius-sm);
    margin-bottom: var(--ds-space-3);
  }

  .journey-coming-soon__sub {
    font-size: var(--ds-type-sm);
    color: var(--ds-on-surface-muted);
    line-height: var(--ds-lead-body);
  }

  .docs-link {
    font-weight: var(--ds-weight-semibold);
    font-size: var(--ds-type-body-lg);
    /* color / text-decoration now come from the global `a` rule in
       base.css — this explicit override was the last plain-text link on
       the site still rendering the withdrawn chromatic accent. */
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-link {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.install-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const cmd = btn.dataset.cmd ?? '';
      try {
        await navigator.clipboard.writeText(cmd);
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.add('install-copy-btn--success');
        setTimeout(() => {
          btn.textContent = orig;
          btn.classList.remove('install-copy-btn--success');
        }, 2000);
      } catch {
        // Clipboard API unavailable — command is still selectable in the code block.
      }
    });
  });
</script>
