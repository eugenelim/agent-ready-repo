---
// The public "Now" surface: outcomes that have actually shipped.
//
// `spec/site-now-surface`. Content comes from one place only — optional
// `Highlights` subsections of RELEASED entries in `docs/product/changelog.md`,
// projected by `tools/build-site.py` into `now-highlights.generated.json`. This
// page renders that projection and derives nothing itself, so a claim can reach
// the public site only by being written into a released changelog entry and
// passing ordinary PR review.
//
// Deliberately absent: anything describing work in progress. No queue, no plans,
// no commits, no `[Unreleased]` content. The tech-site principle "put verifiable
// evidence beside every meaningful claim" is why every group links back to the
// changelog entry it came from.
import SiteLayout from '../../components/layout/SiteLayout.astro';
import Section from '../../components/layout/Section.astro';
import NowHighlights, { type NowGroup } from '../../components/now/NowHighlights.astro';
import projection from '../../lib/now-highlights.generated.json';
import { withBase } from '../../lib/paths';

// The generated payload is the build's contract with the generator. A renamed or
// restructured field would otherwise render an empty or half-blank public page;
// failing the build is the honest outcome, and it makes `schemaVersion` load-
// bearing rather than decorative.
if (projection.schemaVersion !== 1) {
  throw new Error(
    `now-highlights.generated.json is schemaVersion ${projection.schemaVersion}, ` +
      'but this page renders version 1 — regenerate or update the renderer.'
  );
}

const groups = projection.groups as readonly NowGroup[];
---

<SiteLayout
  title="Now — agent-ready-repo"
  description="What has actually shipped, taken from released changelog entries. Every outcome links to the release it came from."
>
  <!-- The complete history as Atom, so a reader can follow releases without
       re-reading a page that grows with every one. SiteLayout exposes this
       named slot, so the link ships on this route only rather than on all 51. -->
  <link
    slot="head"
    rel="alternate"
    type="application/atom+xml"
    title="agent-ready-repo — Now"
    href={withBase('/now/feed.xml')}
  />

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="now-hero" aria-labelledby="now-heading">
    <div class="now-hero__inner">
      <span class="now-hero__eyebrow">Shipped and released</span>
      <h1 id="now-heading" class="now-hero__heading">Now</h1>
      <p class="now-hero__body">
        Outcomes that have shipped in a released version. Each one links to the
        changelog entry that released it, so you can check it rather than take it
        on trust.
      </p>
    </div>
  </section>

  <Section tone="surface" labelledby="now-releases-heading">
    <h2 id="now-releases-heading" class="visually-hidden">Released highlights</h2>
    <NowHighlights groups={groups} />
  </Section>
</SiteLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────── */
  /* PAPER. The dark ground appears exactly once on the surface, at the
     close (docs/design/direction/marketing-site.md, Owner decisions
     2026-09-18). The page hero is not it, so the separation from the band
     below comes from space and a rule, never from a change of ground. */
  .now-hero {
    background-color: var(--ds-surface);
    color: var(--ds-on-surface-2);
    padding: clamp(4rem, 10vw, 7rem) var(--ds-content-pad-x) clamp(3rem, 6vw, 5rem);
  }

  .now-hero__inner {
    max-width: var(--ds-content-max);
    margin-inline: auto;
  }

  /* An eyebrow is a FIELD LABEL. --ds-field-label measures 5.30:1 on
     --ds-surface, clearing 1.4.3 for this 12px run. It is deliberately not
     the mark: the mark means state and nothing else, and decorating an
     eyebrow with it is the retired second job (tokens.css, --ds-clearance). */
  .now-hero__eyebrow {
    display: inline-block;
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-xs);
    text-transform: uppercase;
    letter-spacing: var(--ds-track-label);
    color: var(--ds-field-label);
    margin-bottom: var(--ds-space-4);
  }

  /* No `font-weight` here. The element is an <h1>, so base.css already sets
     the serif display face and carries BOTH variation axes; a `font-weight`
     beside a `font-variation-settings` that names `wght` is overridden by it
     on a variable face and only misleads the next reader. */
  .now-hero__heading {
    font-size: var(--ds-type-display);
    letter-spacing: var(--ds-track-display);
    line-height: var(--ds-lead-display);
    margin-bottom: var(--ds-space-5);
    color: var(--ds-on-surface);
  }

  .now-hero__body {
    font-size: var(--ds-type-body-lg);
    color: var(--ds-on-surface-2);
    max-width: 62ch;
    line-height: var(--ds-lead-body);
  }

</style>
