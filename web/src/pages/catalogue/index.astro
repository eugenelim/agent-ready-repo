---
import { getCollection } from 'astro:content';
import SiteLayout from '../../components/layout/SiteLayout.astro';
import Section from '../../components/layout/Section.astro';
import { withBase } from '../../lib/paths';
import StatusChip from '../../components/primitives/StatusChip.astro';
import {
  catalogueOutcomes,
  catalogueRoles,
} from '../../lib/catalogue-navigation';

// SDLC value-stream order (RFC-0064 three-altitude model + the three loops):
// core anchors first, then strategy → research → shaping → design →
// architecture → contracts → infra → release → governance → docs, with
// supporting tooling and connectors last. Packs not listed fall back to
// alphabetical by name.
const SDLC_ORDER = [
  'core',
  'product-strategy',
  'desk-research',
  'product-engineering',
  'experience-design',
  'architect',
  'contracts',
  'frontend-engineering',
  'iac-terraform',
  'release-engineering',
  'governance-extras',
  'product-documentation',
  'converters',
  'monorepo-extras',
  'catalogue-curation',
  'credential-brokers',
  'atlassian',
  'figma',
  'github',
  'linear',
  'user-guide-diataxis',
];

const allPacks = await getCollection('packs');
const packs = allPacks
  .sort((a, b) => {
    const ai = SDLC_ORDER.indexOf(a.id.replace(/\.md$/, ''));
    const bi = SDLC_ORDER.indexOf(b.id.replace(/\.md$/, ''));
    if (ai !== -1 && bi !== -1) return ai - bi;
    if (ai !== -1) return -1;
    if (bi !== -1) return 1;
    return a.data.name.localeCompare(b.data.name);
  })
  .map((e) => {
    const slug = e.id.replace(/\.md$/, '');
    return {
      slug,
      name: e.data.name,
      scope: e.data.scope,
      tagline: e.data.tagline,
      skillCount: e.data.skills.length,
      detailUrl: withBase(`/packs/${slug}/`),
    };
  });

const roles = catalogueRoles.map((role) => {
  const outcome = catalogueOutcomes.find(({ id }) => id === role.outcomeId);
  if (!outcome) throw new Error(`Unknown catalogue outcome: ${role.outcomeId}`);
  return { ...role, outcome: outcome.title, href: `#${outcome.id}` };
});
---

<SiteLayout
  title="Pack catalogue — agent-ready-repo"
  description={`${packs.length} packs covering the full SDLC. Install any of them with agentbundle on the CLI; the user-scope packs also install as Claude plugins.`}
>
  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="cat-hero" aria-labelledby="cat-hero-heading">
    <div class="cat-hero__inner">
      <span class="cat-hero__eyebrow">Pack catalogue</span>
      <h1 id="cat-hero-heading" class="cat-hero__heading">
        Every pack.<br />Your way.
      </h1>
      <p class="cat-hero__body">
        Start with the work you need to accomplish, then choose the packs that
        produce it. The complete {packs.length}-pack inventory stays below for
        readers who already know what they need.
      </p>
    </div>
  </section>

  <!-- ── Outcome and role discovery ──────────────────────────────────── -->
  <Section tone="surface-alt" labelledby="outcomes-heading">
    <h2 id="outcomes-heading" class="outcomes__heading">What do you need to change?</h2>
    <p class="outcomes__intro">
      Packs are the stable installation layer. These paths are curated views over
      that inventory, so the same pack can support more than one outcome.
    </p>

    {/* A ruled record list, not a grid of cards. Every outcome keeps its
        title, its promise and its pack links; what it loses is the tint, the
        border box, the radius and the second column. See the style block. */}
    <ul class="outcome-records" role="list">
      {catalogueOutcomes.map((outcome) => (
        <li class="outcome-record" id={outcome.id}>
          <h3 class="outcome-record__title">{outcome.title}</h3>
          <p class="outcome-record__desc">{outcome.cataloguePromise}</p>
          <ul class="outcome-record__packs" role="list" aria-label={`Packs for ${outcome.title}`}>
            {outcome.packs.map((pack) => (
              <li><a href={withBase(`/packs/${pack}/`)}>{pack}</a></li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <h2 class="roles__heading">Or start with your role</h2>
    <ul class="role-records" role="list">
      {roles.map((role) => (
        <li class="role-record">
          <a class="role-record__link" href={role.href}>
            <span class="role-record__name">{role.name}</span>
            <span class="role-record__to">{role.outcome} <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <!-- ── Catalogue grid ───────────────────────────────────────────────── -->
  <Section tone="surface" labelledby="cat-grid-heading">
    <h2 id="cat-grid-heading" class="cat-grid__heading">Browse every pack</h2>
    <p class="cat-grid__intro">
      Pack detail pages carry the exact scope, dependencies, install routes,
      shipped primitives, journey, and guides.
    </p>

    {/* One record per pack. The whole row stays the link, which is what
        preserves the target size the card had; the underlined name is the
        affordance that replaces the card's border and fill. */}
    <ul class="pack-records" role="list">
      {packs.map((pack) => (
        <li class="pack-record">
          <a class="pack-record__link" href={pack.detailUrl}>
            <div class="pack-record__head">
              <h3 class="pack-record__name">{pack.name}</h3>
              <StatusChip label={pack.scope} />
              <span class="pack-record__skills">
                {pack.skillCount} skill{pack.skillCount !== 1 ? 's' : ''}
              </span>
            </div>
            <p class="pack-record__tagline">{pack.tagline}</p>
          </a>
        </li>
      ))}
    </ul>
  </Section>
</SiteLayout>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────── */
  /* PAPER. The dark ground appears exactly once on the surface, at the
     close (docs/design/direction/marketing-site.md, Owner decisions
     2026-09-18). The page hero is not it, so the separation from the band
     below comes from space and a rule, never from a change of ground. */
  .cat-hero {
    background-color: var(--ds-surface);
    color: var(--ds-on-surface-2);
    padding-block: clamp(4rem, 10vw, 7rem) clamp(3rem, 6vw, 5rem);
  }

  /* Same recipe as Section.astro's `.section__inner`: the horizontal padding
     goes INSIDE the max-width wrapper, not outside it. Padding the outer
     element instead centred a 1140px column inside 1440-80px, which put the
     hero's left axis at 150px while every band below it started at 190px.
     The break only appeared above 1220px, so no gate saw it and only the
     1440 capture did. `[edge]` alignment asks for one dominant left axis and
     the homepage hero already measures 190px, so this is the axis the page
     was supposed to be on. */
  .cat-hero__inner {
    max-width: var(--ds-content-max);
    margin-inline: auto;
    padding-inline: var(--ds-content-pad-x);
  }

  /* An eyebrow is a FIELD LABEL. --ds-field-label measures 5.30:1 on
     --ds-surface, clearing 1.4.3 for this 12px run. It is deliberately not
     the mark: the mark means state and nothing else, and decorating an
     eyebrow with it is the retired second job (tokens.css, --ds-clearance). */
  .cat-hero__eyebrow {
    display: inline-block;
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-xs);
    text-transform: uppercase;
    letter-spacing: var(--ds-track-label);
    color: var(--ds-field-label);
    margin-bottom: var(--ds-space-4);
  }

  /* No `font-weight` here. The element is an <h1>, so base.css already sets
     the serif display face and carries BOTH variation axes; a `font-weight`
     beside a `font-variation-settings` that names `wght` is overridden by it
     on a variable face and only misleads the next reader. */
  .cat-hero__heading {
    font-size: var(--ds-type-display);
    letter-spacing: var(--ds-track-display);
    line-height: var(--ds-lead-display);
    margin-bottom: var(--ds-space-5);
    color: var(--ds-on-surface);
  }

  .cat-hero__body {
    font-size: var(--ds-type-body-lg);
    color: var(--ds-on-surface-2);
    max-width: 62ch;
    line-height: var(--ds-lead-body);
    margin-bottom: var(--ds-space-5);
  }

  .cat-hero__body code {
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-mono-sm);
    color: var(--ds-on-surface);
    background: none;
  }

  /* ── Outcome and role discovery ───────────────────────────────────── */
  .outcomes__heading,
  .roles__heading {
    margin-bottom: var(--ds-space-3);
  }

  .outcomes__intro,
  .cat-grid__intro {
    color: var(--ds-on-surface-2);
    font-size: var(--ds-type-body-lg);
    margin-bottom: var(--ds-space-7);
    max-width: 64ch;
  }

  /* ── The three record lists ────────────────────────────────────────────
     This page used to be three grids of tinted, bordered, rounded cards:
     seven outcomes, six roles and twenty-two packs. That contradicted three
     axes of the direction sheet at once — `[ruled]` containment ("rules
     divide and rank; no cards, no tinted panels, no shadows, no overlap"),
     `[flat]` material ("separation comes from rules, space and alignment")
     and `[none]` ornament — and it was the THIRD instance of the same
     settled decision, after the homepage outcome band and /now/.

     The pattern is the one already shipped in PackCatalogue.astro and
     WhatYouInstall.astro, not a new one. Rules are carried on the TOP edge
     of each record with the list closing on its own bottom rule, so one
     record can be ranked later without doubling a line.

     --ds-rule-boundary measures 3.53:1 on --ds-surface and 3.26:1 on
     --ds-surface-alt; it is the edge of a list and owes the 3:1 non-text
     floor, and it clears it. --ds-rule-hairline measures 2.05:1 and 1.89:1
     respectively, which does not clear 3:1 — and it does not owe it here,
     because it divides records that space and type already separate, so no
     information depends on it and it is never the sole carrier of a state
     or of a control's edge. PackCatalogue.astro and WhatYouInstall.astro
     make the identical pairing and measure identically, the latter on this
     same alt ground. (tokens.css:116 annotates --ds-rule-hairline "non-text
     contrast floor" while the token measures below it. That annotation is
     older than this page and governs three components; reconciling it is
     not this change's to make.)

     Two defects go with the grids rather than beside them:

       - UNEVEN HEIGHTS. Descriptions of unequal length in an auto-track
         grid gave every row a ragged bottom edge, and the tint made each
         box visible, so the raggedness was the loudest thing in the band.
         A record bounded by a rule ends where its content ends.
       - THE ORPHAN. Seven outcomes on `auto-fit` stranded the last card
         alone in a part-width row at both two and three columns, and
         twenty-two packs on `auto-fill` did the same at three and four. A
         list has no orphan, at any count, so the counts can change without
         a layout consequence.

     `[manuscript]` grid grammar asks for one reading column at a generous
     measure and forbids a second column of content, so the 68ch bound is
     the measure rather than a narrower version of the band. The grids'
     `minmax(280px, 1fr)` tracks needed arithmetic against three
     breakpoints; one column needs none, which is why no breakpoint is
     added below. */
  .outcome-records,
  .role-records,
  .pack-records {
    border-bottom: 1px solid var(--ds-rule-boundary);
    max-width: 68ch;
  }

  .outcome-record,
  .role-record,
  .pack-record {
    border-top: 1px solid var(--ds-rule-hairline);
  }

  .outcome-records > :first-child,
  .role-records > :first-child,
  .pack-records > :first-child {
    border-top: 1px solid var(--ds-rule-boundary);
  }

  /* The role list jumps to these ids, so the scroll offset is kept from the
     card it replaces. */
  .outcome-record {
    padding-block: var(--ds-space-5);
    scroll-margin-top: var(--ds-space-7);
  }

  .outcome-records {
    margin-bottom: var(--ds-space-8);
  }

  .outcome-record__title {
    font-size: var(--ds-type-h3);
    margin-bottom: var(--ds-space-2);
  }

  .outcome-record__desc {
    color: var(--ds-on-surface-2);
    margin-bottom: var(--ds-space-3);
    max-width: 62ch;
  }

  /* The pack links were bordered, rounded, padded chips that opted out of
     the site-wide underline and named border + shape + mono face as the
     replacement channel. With `[flat]` and `[ruled]` honoured there is no
     border and no radius left to carry that channel, so the opt-out is
     withdrawn and the links take the baseline underline from base.css —
     the same exchange PackCatalogue.astro made for the same links.

     The column gap is 16px so adjacent underlined runs do not read as one
     phrase; the row gap is 8px because it is a VERTICAL measure and the
     rule pitch governs it.

     `line-height: 2` puts the row on the 8px pitch — a 24px line box where
     the inherited 1.65 body leading gives 19.8px — and widens a margin that
     was already met. These links measure 115.2 x 16.0 CSS px, under the
     24px WCAG 2.5.8 Target Size (Minimum) floor and the same size as the
     shipped homepage links they copy, so they pass on the criterion's
     SPACING exception: 24px circles centred on each target must not
     intersect. With this declaration wrapped rows sit 32px apart centre to
     centre; without it, 27.8px. The exception is met either way, so the
     declaration buys pitch and 4.2px of headroom, not the pass.
     PackCatalogue.astro sets no line-height here. axe with wcag22aa reports
     0 violations at 390 and 1280. */
  .outcome-record__packs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ds-space-2) var(--ds-space-4);
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-xs);
    line-height: 2;
  }

  /* ── Roles ─────────────────────────────────────────────────────────────
     The row is the link, as the card was, so the target the reader aims at
     does not shrink. Every VERTICAL measure declared here is a multiple of
     the 8px rule pitch; 16px of padding on a 16px body line then computes
     to a 58.4px row, comfortably over the 44px floor.

     The row opts out of the baseline underline and the name carries it
     instead: underlining a whole two-part row would read as one struck
     phrase. The channel is still an underline, present at rest, not a
     border or a fill. */
  .role-record__link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--ds-space-2) var(--ds-space-4);
    padding-block: var(--ds-space-4);
    color: var(--ds-on-surface);
    text-decoration: none;
  }

  .role-record__name {
    font-weight: var(--ds-weight-semibold);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* The destination, as a field. --ds-field-label measures 4.89:1 on
     --ds-surface-alt, which is this band's ground, clearing 1.4.3. */
  .role-record__to {
    color: var(--ds-field-label);
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-xs);
    letter-spacing: 0.02em;
  }

  /* ── Every pack ────────────────────────────────────────────────────── */
  .cat-grid__heading {
    margin-bottom: var(--ds-space-3);
  }

  .pack-records {
    margin-bottom: var(--ds-space-9);
  }

  /* Opts out of the site-wide underline for the same reason the role row
     does, and names the same replacement: underlining a whole record would
     strike the tagline too, so `.pack-record__name` below carries the
     underline instead. The channel is still an underline, present at rest —
     not a border, a fill or a colour (base.css, the `:where(a)` baseline). */
  .pack-record__link {
    display: block;
    padding-block: var(--ds-space-4);
    color: inherit;
    text-decoration: none;
  }

  .pack-record__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--ds-space-3);
    margin-bottom: var(--ds-space-2);
  }

  .pack-record__name {
    font-size: var(--ds-type-h3);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  /* The skill count, as a field beside the scope chip. --ds-field-label
     measures 5.30:1 on --ds-surface, this band's ground. */
  .pack-record__skills {
    color: var(--ds-field-label);
    font-family: var(--ds-font-mono);
    font-size: var(--ds-type-xs);
    letter-spacing: 0.02em;
  }

  .pack-record__tagline {
    color: var(--ds-on-surface-2);
    max-width: 62ch;
  }

  /* The card's hover was a border-colour change on a border that no longer
     exists, and its "View pack" cue duplicated a link the underline now
     names. What replaces both is a thicker underline on the name — no
     motion, so no `prefers-reduced-motion` guard is owed, and no colour, so
     it is not a hue-only signal. Focus is paired with hover deliberately;
     the global ring in base.css is the other half. */
  .role-record__link:hover .role-record__name,
  .role-record__link:focus-visible .role-record__name,
  .pack-record__link:hover .pack-record__name,
  .pack-record__link:focus-visible .pack-record__name {
    text-decoration-thickness: 2px;
  }

</style>
