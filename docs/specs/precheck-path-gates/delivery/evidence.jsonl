{"records":[{"findings":[{"actual_failure":"When the base and HEAD share no merge base (shallow clone, unrelated base), git diff exits 128 with empty output, so precheck prints 'no trigger matched' and exits 0 instead of exiting 2.","affected_acceptance_criteria":["AC-0008"],"evidence_refs":["tools/precheck.py:80","tools/precheck.py:82","tools/precheck.py:208"],"finding_id":"adv-1","material":true,"observation":"changed_paths discards the exit status of git diff --name-only <base>...HEAD and of git status.","reachable_path":"tools/precheck.py:80-82; main reaches it after rev-parse --verify succeeds","rule_ref":"AC-0008 fail-closed git handling","schema_version":1},{"actual_failure":"With --with-tests, a pytest run killed by signal returns -9 while the other checks return 0, so precheck exits 0.","affected_acceptance_criteria":["AC-0010"],"evidence_refs":["tools/precheck.py:186"],"finding_id":"adv-2","material":true,"observation":"The overall status is max(results), and a check killed by a signal returns a negative status that ranks below 0.","reachable_path":"tools/precheck.py:186","rule_ref":"AC-0010 non-zero exit when a run fails","schema_version":1},{"actual_failure":"pytest exits 4 on a missing directory, so --with-tests fails for those packs, and without the flag the printed command cannot work.","affected_acceptance_criteria":["AC-0009","AC-0010"],"evidence_refs":["tools/precheck.py:174","tools/precheck.py:182"],"finding_id":"adv-3","material":true,"observation":"Every touched pack gets pytest packs/<pack>/tests, but eight packs have no tests directory.","reachable_path":"tools/precheck.py:174-182; a change under packs/contracts with or without --with-tests","rule_ref":"AC-0009 and AC-0010 touched-pack suites","schema_version":1},{"actual_failure":"With agentbundle missing, a .apm SKILL.md change prints 'skipped: agentbundle not installed' twice, and nothing says which is self-host and which is the deep lint.","affected_acceptance_criteria":["AC-0007"],"evidence_refs":["tools/precheck.py:98","tools/precheck.py:110"],"finding_id":"adv-4","material":true,"observation":"The skip line names the missing tool but not the skipped check.","reachable_path":"tools/precheck.py:98-99,110-114","rule_ref":"AC-0007 and the Always-do rule to name each skipped check","schema_version":1},{"actual_failure":"python3 tools/precheck.py in this checkout finds no agentbundle, so it skips self-host and the drive step expecting a drift result passes without it; there is no working route to --with-tests or --base through make.","affected_acceptance_criteria":["AC-0017","AC-0013"],"evidence_refs":["docs/VERIFICATION.md","AGENTS.md","Makefile:16"],"finding_id":"adv-5","material":true,"observation":"agentbundle is importable only through the Makefile PYTHONPATH, and make precheck cannot take a flag.","reachable_path":"docs/VERIFICATION.md launch and drive steps; AGENTS.md commands block","rule_ref":"AC-0017 and AC-0013 documented launch","schema_version":1},{"actual_failure":"On this repo the rule extracts lint-ruff, lint-mypy, test, build-self and never precheck, so deleting the precheck target would not trip it; a prose paragraph with the line 'make any push.' yields the targets 'any' and 'push.'.","affected_acceptance_criteria":["AC-0015"],"evidence_refs":["tools/lint-agents-md.py:150","tools/lint-agents-md.py:170"],"finding_id":"adv-6","material":true,"observation":"_MAKE_INVOCATION consumes the rest of the line and keeps only the part before a semicolon, and any prose line starting with make is read as an invocation.","reachable_path":"tools/lint-agents-md.py:150,170-178","rule_ref":"AC-0015 local-gate lint","schema_version":1},{"actual_failure":"A reviewer cannot tell the re-pin apart from an unrelated plan change hidden in the same edit.","affected_acceptance_criteria":["AC-0012"],"evidence_refs":["tools/test_local_ci_shared_test_deduplication.py:1135"],"finding_id":"adv-7","material":true,"observation":"The two re-pinned plan digests carry no dated comment naming the sole cause, unlike every earlier re-pin.","reachable_path":"tools/test_local_ci_shared_test_deduplication.py:1135-1140","rule_ref":"AC-0012 pinned plan digests","schema_version":1}],"lineage":{"producer":"adversarial-reviewer","review_policy_fingerprint":"review-policy-sha256:7abdc66504438809f21f14f2b3b75b377c46a6d0f7e447d1c0fa99be472c075b","sequence":1,"source_event_id":"review:adversarial-reviewer:d9711f4443307fa4b56e9db0:1"},"report_id":"rpt-adversarial-reviewer-1","role":"adversarial-reviewer","schema_version":1,"subject":{"delivery_subject_ref":{"acceptance_fingerprint":"3ff60b7244345c5e6032ddb9c140f8e75ccf53edae5324bdc2bb07a783e03571","subject_id":"run-a0b23fbabd9eb4f2"},"lineage":{"projection_version":"1.0","provider":"core-review-subject-projector"},"normalized_paths":[".github/workflows/build-check.yml","AGENTS.md","AGENT_RULES.md","Makefile","docs/VERIFICATION.md","tools/lint-agents-md.py","tools/lint-ci-parity.py","tools/precheck.py","tools/test_lint_agents_md_local_gate.py","tools/test_local_ci_shared_test_deduplication.py","tools/test_precheck.py"],"normalized_statuses":["modified","modified","modified","modified","modified","modified","modified","added","added","modified","added"],"review_policy_fingerprint":"review-policy-sha256:7abdc66504438809f21f14f2b3b75b377c46a6d0f7e447d1c0fa99be472c075b","review_subject_fingerprint":"review-subject-sha256:ea4901a32be62dc5db8859cf14141ebd0107ae96d9711f4443307fa4b56e9db0","review_subject_id":"review-subject-sha256:ea4901a32be62dc5db8859cf14141ebd0107ae96d9711f4443307fa4b56e9db0","schema_version":1},"terminal_status":"findings"}],"tx":{"acceptance_fingerprint":"3ff60b7244345c5e6032ddb9c140f8e75ccf53edae5324bdc2bb07a783e03571","checksum":"sha256:2b2cd9f62089139fbe7f79845f029c7207349f85577a9eb70804ea75063f6418","ordered_record_ids":["rpt-adversarial-reviewer-1"],"schema_version":1,"transaction_id":"tx:review:adversarial-reviewer:d9711f4443307fa4b56e9db0:1"}}
