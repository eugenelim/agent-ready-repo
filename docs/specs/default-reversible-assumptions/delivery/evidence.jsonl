{"records":[{"findings":[{"actual_failure":"An agent that follows step 3 would wait, and the case grades that correct behaviour as failing.","affected_acceptance_criteria":["AC-0020"],"evidence_refs":["packs/core/.apm/skills/new-spec/evals/evals.json"],"finding_id":"adv-1-1","material":true,"observation":"The reversible-default eval prompt says nobody has stated a page size, which falls in the no-stated-default wait class and the tie-break.","reachable_path":"packs/core/.apm/skills/new-spec/evals/evals.json reversible-assumption-proceeds-on-logged-default","rule_ref":"AC-0020","schema_version":1},{"actual_failure":"Two authoring agents can sort the same item in opposite directions.","affected_acceptance_criteria":["AC-0001"],"evidence_refs":["packs/core/.apm/skills/new-spec/SKILL.md"],"finding_id":"adv-1-2","material":true,"observation":"Step 3 does not say who must state a default, so 'an item with no stated default' has no defined source.","reachable_path":"packs/core/.apm/skills/new-spec/SKILL.md step 3 sort paragraph","rule_ref":"AC-0001","schema_version":1},{"actual_failure":"An item outside every wait class that fails the test may be defaulted anyway.","affected_acceptance_criteria":["AC-0004"],"evidence_refs":["packs/core/.apm/skills/new-spec/SKILL.md"],"finding_id":"adv-1-3","material":true,"observation":"Step 3 says to check an item against the reversibility test but not what happens when the check fails.","reachable_path":"packs/core/.apm/skills/new-spec/SKILL.md step 3 sort paragraph","rule_ref":"AC-0004","schema_version":1},{"actual_failure":"An agent may write none and then add Defaulted lines beneath it.","affected_acceptance_criteria":["AC-0014"],"evidence_refs":["packs/core/.apm/skills/new-spec/SKILL.md"],"finding_id":"adv-1-4","material":false,"observation":"The 'or none' bullet precedes the bullet that writes Defaulted lines into the same section.","reachable_path":"packs/core/.apm/skills/new-spec/SKILL.md step 3 Only-once bullets","rule_ref":"AC-0014","schema_version":1},{"actual_failure":"The new defaulted shape sits under framing that contradicts it.","affected_acceptance_criteria":["AC-0016"],"evidence_refs":["packs/core/.apm/skills/new-spec/assets/spec.md"],"finding_id":"adv-1-5","material":false,"observation":"The template's Assumptions comment still frames every item as an unanswered question and a known gap.","reachable_path":"packs/core/.apm/skills/new-spec/assets/spec.md Assumptions comment","rule_ref":"AC-0016","schema_version":1}],"lineage":{"producer":"adversarial-reviewer","review_policy_fingerprint":"review-policy-sha256:7abdc66504438809f21f14f2b3b75b377c46a6d0f7e447d1c0fa99be472c075b","sequence":1,"source_event_id":"agent-a3ca5958c96d97cf8-round-1"},"report_id":"report-adversarial-reviewer-1","role":"adversarial-reviewer","schema_version":1,"subject":{"delivery_subject_ref":{"acceptance_fingerprint":"1fdceeeb56ca943c9723dd339f8584c0233f1b59ebc5db4ae19320569cb538b9","subject_id":"run-ab6ecaa96b36e9dc"},"lineage":{"projection_version":"1.0","provider":"core-review-subject-projector"},"normalized_paths":["docs/product/changelog.d/3b338819-fd6e-4cee-9b7a-5f1c01741ed3.md","packs/core/.apm/skills/new-spec/SKILL.md","packs/core/.apm/skills/new-spec/assets/spec.md","packs/core/.apm/skills/new-spec/evals/evals.json","packs/core/.claude-plugin/plugin.json","packs/core/pack.toml","packs/core/tests/skills/new-spec/test_default_reversible_assumptions.py"],"normalized_statuses":["added","modified","modified","modified","modified","modified","added"],"review_policy_fingerprint":"review-policy-sha256:7abdc66504438809f21f14f2b3b75b377c46a6d0f7e447d1c0fa99be472c075b","review_subject_fingerprint":"review-subject-sha256:25df49900fcda37556fd6803b1410677b08d35f6a637cfd8ce3062adc717a9f7","review_subject_id":"review-subject-sha256:25df49900fcda37556fd6803b1410677b08d35f6a637cfd8ce3062adc717a9f7","schema_version":1},"terminal_status":"findings"}],"tx":{"acceptance_fingerprint":"1fdceeeb56ca943c9723dd339f8584c0233f1b59