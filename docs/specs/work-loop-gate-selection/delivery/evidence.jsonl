{"records":[{"findings":[{"actual_failure":"An agent following the rule looks in the verify-entry locations, finds no precheck there, and writes that none exists, so a Makefile or CI-declared check goes unnamed in Done when, which is the omission the rule exists to catch.","affected_acceptance_criteria":["AC-0001","AC-0002"],"evidence_refs":["packs/core/.apm/skills/work-loop/references/verification-modes.md:279","packs/core/.apm/skills/work-loop/references/verification-modes.md:68"],"finding_id":"b-adv-1","material":true,"observation":"The new section tells an agent to look at the repository's build or verification entry, but the same file defines a verify entry as a saved recipe for driving one surface, and the SKILL.md paragraph above the new rule links to that section.","reachable_path":"packs/core/.apm/skills/work-loop/references/verification-modes.md:279-281 and SKILL.md PLAN step 7","rule_ref":"AC-0001 and AC-0002 gate selection guidance","schema_version":1}],"lineage":{"producer":"adversarial-reviewer","review_policy_fingerprint":"review-policy-sha256:21507f7f8b17b5f59a80b8b3d72a4660be21673c8e2112b15487d6d9974d48ce","sequence":1,"source_event_id":"review:adversarial-reviewer:07070742fd10c0dac846c38d:1"},"report_id":"rpt-adversarial-reviewer-c846c38d","role":"adversarial-reviewer","schema_version":1,"subject":{"delivery_subject_ref":{"acceptance_fingerprint":"a9f07d66c7737dad0804d90574e877a81d78257fc2c1703fb6230d9b03cef66f","subject_id":"run-0cb3f2d23fc3ae50"},"lineage":{"projection_version":"1.0","provider":"core-review-subject-projector"},"normalized_paths":["docs/product/changelog.d/213d8071-0b76-4b80-ae4d-8094452865e2.md","packs/core/.apm/skills/work-loop/SKILL.md","packs/core/.apm/skills/work-loop/evals/evals.json","packs/core/.apm/skills/work-loop/references/verification-modes.md","packs/core/.claude-plugin/plugin.json","packs/core/pack.toml","packs/core/tests/skills/work-loop/test_gate_selection_contract.py"],"normalized_statuses":["added","modified","m