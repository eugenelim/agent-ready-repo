{"records":[{"findings":[{"actual_failure":"Until the closeout merges main, T1's Done-when wording is literally false; the closeout merge must take the branch side (4.0.23, fragment 6cd517c8) in all three conflicts.","affected_acceptance_criteria":["AC-0001"],"evidence_refs":["docs/specs/supervisor-racy-index-copy/plan.md:40","docs/specs/supervisor-racy-index-copy/plan.md:71","docs/specs/supervisor-racy-index-copy/spec.md:70"],"finding_id":"adv2-23844ec0013c-1","material":false,"observation":"plan.md lines 40 and 71 say Core is one patch above the merge base, but the merge base with origin/main is still 6da52f9 (Core 4.0.21) while the branch carries 4.0.23, one patch above origin/main's tip a242146b9 (4.0.22); the spec's Closeout already states the rule against a freshly fetched origin/main.","reachable_path":"git merge-base HEAD origin/main -> 6da52f9 (4.0.21); git merge-tree --write-tree origin/main HEAD -> content conflicts in packs/core/pack.toml, packs/core/.claude-plugin/plugin.json, tests/roster/test_registry_upgrade_notes.py","rule_ref":"AC-0001 closeout; plan Constraints and T1 Done when: Core one patch above the merge base","schema_version":1}],"lineage":{"producer":"adversarial-reviewer","review_policy_fingerprint":"review-policy-sha256:b98ed64621e27a6babf52a5b8ec48bc6a3d54aa5530e7fa90b1a1f52429f5776","sequence":1,"source_event_id":"adversarial-reviewer-23844ec0013c-1"},"report_id":"report-adversarial-reviewer-23844ec0013c-1","role":"adversarial-reviewer","schema_version":1,"subject":{"delivery_subject_ref":{"acceptance_fingerprint":"7fe36ccee663c13b1d6e18f3b87505b5c4b39001f5a7f25cc10fd301ddf02727","subject_id":"run-1db42959521d6730"},"lineage":{"projection_version":"1.0","provider":"core-review-subject-projector"},"normalized_paths":["docs/product/changelog.d/6cd517c8-29e2-4d52-989c-f002283bfe71.md","packs/core/.apm/skills/work-loop/scripts/_supervisor_commit.py","packs/core/.claude-plugin/plugin.json","packs/core/pack.toml","packs/core/tests/skills/work