{"records":[{"findings":[{"actual_failure":"The stated threat model under-states what a worker with .git/ write access can hide; no new capability, since that worker can already hand-write index entries.","affected_acceptance_criteria":["AC-0001"],"evidence_refs":["packs/core/.apm/skills/work-loop/scripts/_supervisor_commit.py:876-878","packs/core/.apm/skills/work-loop/scripts/_supervisor_commit.py:926"],"finding_id":"sec1-a29e503e3d6a-1","material":false,"observation":"The _PrivateIndex docstring accepts a hand-written index as a residual risk but does not say the index file's own modification time is trusted on the same terms; the copy now inherits that time.","reachable_path":"a worker that can write .git/ runs touch .git/index -> _copy_index fstat -> os.utime gives the copy the later time -> a same-size rewrite in the old index second is not racy and Git trusts its stat data","rule_ref":"AC-0001; accepted residual risk must be stated in full","schema_version":1}],"lineage":{"producer":"security-reviewer","review_policy_fingerprint":"review-policy-sha256:b98ed64621e27a6babf52a5b8ec48bc6a3d54aa5530e7fa90b1a1f52429f5776","sequence":1,"source_event_id":"security-reviewer-a29e503e3d6a-1"},"report_id":"report-security-reviewer-a29e503e3d6a-1","role":"security-reviewer","schema_version":1,"subject":{"delivery_subject_ref":{"acceptance_fingerprint":"8e7c42452af9f440ea082329da029721ccce2ca9589164a282f4cba2b474c829","subject_id":"run-1db42959521d6730"},"lineage":{"projection_version":"1.0","provider":"core-review-subject-projector"},"normalized_paths":["docs/product/changelog.d/6cd517c8-29e2-4d52-989c-f002283bfe71.md","packs/core/.apm/skills/work-loop/scripts/_supervisor_commit.py","packs/core/.claude-plugin/plugin.json","packs/core/pack.toml","packs/core/tests/skills/work-loop/test_supervisor_git.py","tests/roster/test_registry_upgrade_notes.py"],"normalized_statuses":["added","modified","modified","modified","modified","modified"],"review_policy_fingerprint":"review-pol