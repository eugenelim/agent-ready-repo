{"capture_id":"kco-202609-8820a0f123150bb5319e442fce8b2c1a45a547df2d08fbb35d90439c917426ea","captured_at":"2026-09-01T01:37:30Z","event_type":"observation.captured","partition":"observations/pattern/2026-09.jsonl","request":{"competency_facets":["CQ-DESIGN","CQ-OPERATE"],"contract_version":"knowledge-captured-observation.v1","destination_hint":{"path":"docs/knowledge/topics","type":"topic"},"freshness_anchor":{"digest":{"byte_length":27303,"kind":"sha256-bytes-v1","sha256":"f8d8b8e3b1fb4f69fd5d9d0611e625a1d6a620bdfc012c044ce8ef6e4886e0e0"},"path":"docs/specs/review-record-idempotency/plan.md"},"kind":"pattern","lesson":"A safety cap enforced only by shell syntax in agent-facing instructions is one reformat away from gone. A retry cap carried by an && chaining a guarded transition to an unguarded write stopped being enforced the moment the statement was split for an unrelated reason, and the write verb exceeded the cap when called directly. Put the guard in the verb, not in the instruction's punctuation.","observed_at":"2026-09-01T01:37:30Z","privacy_attestation":{"contains_instructions":false,"contains_private_data":false,"contains_secrets":false,"reviewed":true},"producer":{"workflow":"work-loop","workflow_version":"work-loop-producer-profile.v1"},"project_scope":{"audience":"project","paths":["packs/core/.apm/skills/work-loop"]},"provenance":{"sources":[{"path":"packs/core/.apm/skills/work-loop/SKILL.md"}]},"semantic_gate":{"artifact":"docs/specs/review-record-idempotency/plan.md","name":"plan-locked"}},"request_sha256":"8820a0f123150bb5319e442fce8b2c1a45a547df2d08fbb35d90439c917426ea","schema_version":"observation-event.v1","state":"pending"}
