{"capture_id":"kco-202609-68c2d3cd46ebf3a5936104fe9fc4e908afff51012b8e0be22d449d28d85963fd","captured_at":"2026-09-01T01:37:29Z","event_type":"observation.captured","partition":"observations/gotcha/2026-09.jsonl","request":{"competency_facets":["CQ-CHANGE","CQ-REVIEW"],"contract_version":"knowledge-captured-observation.v1","destination_hint":{"path":"docs/knowledge/topics","type":"topic"},"freshness_anchor":{"digest":{"byte_length":27303,"kind":"sha256-bytes-v1","sha256":"f8d8b8e3b1fb4f69fd5d9d0611e625a1d6a620bdfc012c044ce8ef6e4886e0e0"},"path":"docs/specs/review-record-idempotency/plan.md"},"kind":"gotcha","lesson":"Python's $ matches before a trailing newline and \\d accepts Unicode decimal digits, so an identifier regex anchored with ^...$ fails open. When the validated string is later compared by exact equality against persisted state, x:1, x:1 with a trailing newline, and x:01 are three spellings of one identity that all pass and compare unequal, defeating an idempotency guard. Use \\A and \\Z, an explicit 0-9 class, a length cap, and a canonical-form check whenever the validated value is compared as a string.","observed_at":"2026-09-01T01:37:29Z","privacy_attestation":{"contains_instructions":false,"contains_private_data":false,"contains_secrets":false,"reviewed":true},"producer":{"workflow":"work-loop","workflow_version":"work-loop-producer-profile.v1"},"project_scope":{"audience":"project","paths":["packs/core/.apm/skills/work-loop"]},"provenance":{"sources":[{"path":"packs/core/.apm/skills/work-loop/scripts/loop-cohort.py"}]},"semantic_gate":{"artifact":"docs/specs/review-record-idempotency/plan.md","name":"plan-locked"}},"request_sha256":"68c2d3cd46ebf3a5936104fe9fc4e908afff51012b8e0be22d449d28d85963fd","schema_version":"observation-event.v1","state":"pending"}
