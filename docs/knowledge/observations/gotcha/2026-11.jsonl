{"capture_id":"kco-202611-123de45c68f6c6b88f9671310de478a38ca27d80d92a9bacb334c8de8151c004","captured_at":"2026-11-04T12:53:51Z","event_type":"observation.captured","partition":"observations/gotcha/2026-11.jsonl","request":{"competency_facets":["CQ-VERIFY"],"contract_version":"knowledge-captured-observation.v2","destination_hint":{"path":"docs/knowledge/topics/a-criterions-declared-verification-mode-needs-a-matching-plan-artifact.json","type":"topic"},"freshness_anchor":{"digest":{"byte_length":16249,"kind":"sha256-bytes-v1","sha256":"41aed6144dee4427e1a408251d47e6148ed75551c36a4ddb68eeca5c2965d4e6"},"path":"docs/specs/work-item-promotion-handoff/plan.md"},"kind":"gotcha","lesson":"A criterion whose spec Testing Strategy declares a specific verification mode needs a plan artifact that performs exactly that check: a unit test over the same behavior does not satisfy a goal-based store-replay criterion, and the completion gate cannot close the criterion in its declared mode. The work-item-promotion-handoff plan carries a store-replay bullet beside its fixture drain so AC-0003 and AC-0004 have artifacts in the mode the spec declares for them.","observed_at":"2026-11-04T12:53:51Z","privacy_attestation":{"contains_instructions":false,"contains_private_data":false,"contains_secrets":false,"reviewed":true},"producer":{"workflow":"work-loop","workflow_version":"work-loop-producer-profile.v1"},"project_scope":{"audience":"project","paths":["docs/specs/work-item-promotion-handoff/plan.md","docs/specs/work-item-promotion-handoff/spec.md"]},"provenance":{"sources":[{"line_end":53,"line_start":50,"path":"docs/specs/work-item-promotion-handoff/plan.md"},{"line_end":413,"line_start":411,"path":"docs/specs/work-item-promotion-handoff/spec.md"}]},"semantic_gate":{"artifact":"docs/specs/work-item-promotion-handoff/plan.md","name":"plan-locked"}},"request_sha256":"123de45c68f6c6b88f9671310de478a38ca27d80d92a9bacb334c8de8151c004","schema_version":"observation-event.v1","state":"pending"}
