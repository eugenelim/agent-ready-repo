  "synthesis": {
    "body": "A criterion whose spec Testing Strategy declares a specific verification mode needs a plan artifact that performs exactly that check: a unit test over the same behavior does not satisfy a goal-based store-replay criterion, and the completion gate cannot close the criterion in its declared mode. When authoring a plan, walk the spec's Testing Strategy entries and give each declared mode a plan artifact in that mode — for store-replay criteria, a replay check over the fixture store beside the drain that produces it.",
    "kind": "gotcha"
  },
  "title": "A criterion's declared verification mode needs a matching plan artifact",
  "topic_key": "a-criterions-declared-verification-mode-needs-a-matching-plan-artifact"
}
