  "synthesis": {
    "body": "A TemporaryDirectory created beneath a checkout is still inside that checkout: git -C walks upward and may resolve the parent repository. Tests for no-repository or no-base behavior should initialize an explicit nested repository boundary without the ref, or place the fixture outside every checkout.",
    "kind": "gotcha"
  },
  "title": "In-repository TMPDIR changes Git fixture semantics",
